{
  "schema_version": 1,
  "package": {
    "id": "alkahest-book-template-engine",
    "version": "0.2.0",
    "filename": "alkahest-book-template-engine-0.2.0.zip",
    "root_name": "alkahest-book-template-engine-0.2.0",
    "output_root": "book/_build/template",
    "license": "MIT",
    "compression": "stored"
  },
  "directory_components": [
    {
      "id": "extensions",
      "source": "book/_extensions",
      "destination": "_extensions",
      "exclude_patterns": []
    },
    {
      "id": "filters",
      "source": "book/filters",
      "destination": "filters",
      "exclude_patterns": []
    },
    {
      "id": "latex",
      "source": "book/latex",
      "destination": "latex",
      "exclude_patterns": []
    },
    {
      "id": "theme",
      "source": "book/theme",
      "destination": "theme",
      "exclude_patterns": [
        "^fonts(?:/|$)"
      ]
    },
    {
      "id": "typst",
      "source": "book/typst",
      "destination": "typst",
      "exclude_patterns": []
    }
  ],
  "file_components": [
    {
      "id": "quarto-defaults",
      "source": "book/alkahest-defaults.yml",
      "destination": "defaults/quarto.yml"
    },
    {
      "id": "theme-defaults",
      "source": "book/alkahest-theme-defaults.json",
      "destination": "defaults/theme.json"
    },
    {
      "id": "release-defaults",
      "source": "book/alkahest-release-defaults.json",
      "destination": "defaults/releases.json"
    },
    {
      "id": "extension-api-documentation",
      "source": "docs/extension-apis.md",
      "destination": "docs/extension-apis.md"
    },
    {
      "id": "book-contract-documentation",
      "source": "docs/book-contracts.md",
      "destination": "docs/book-contracts.md"
    },
    {
      "id": "schema-publication",
      "source": "config/metadata/publication.schema.json",
      "destination": "schemas/publication.schema.json"
    },
    {
      "id": "theme-sync",
      "source": "scripts/sync-theme.py",
      "destination": "scripts/sync-theme.py"
    },
    {
      "id": "theme-library",
      "source": "src/alkahest/theme.py",
      "destination": "src/alkahest/theme.py"
    },
    {
      "id": "release-sync",
      "source": "scripts/sync-release-profiles.py",
      "destination": "scripts/sync-release-profiles.py"
    },
    {
      "id": "release-stage",
      "source": "scripts/stage-release.py",
      "destination": "scripts/stage-release.py"
    },
    {
      "id": "release-library",
      "source": "src/alkahest/release_profiles.py",
      "destination": "src/alkahest/release_profiles.py"
    },
    {
      "id": "author-command",
      "source": "scripts/author.py",
      "destination": "scripts/author.py"
    },
    {
      "id": "author-library",
      "source": "src/alkahest/author_project.py",
      "destination": "src/alkahest/author_project.py"
    },
    {
      "id": "process-library",
      "source": "src/alkahest/process.py",
      "destination": "src/alkahest/process.py"
    },
    {
      "id": "theme-package-init",
      "source": "src/alkahest/__init__.py",
      "destination": "src/alkahest/__init__.py"
    },
    {
      "id": "license",
      "source": "LICENSE",
      "destination": "LICENSE"
    },
    {
      "id": "package-readme",
      "source": "template/README.md",
      "destination": "README.md"
    }
  ],
  "required_paths": [
    "LICENSE",
    "README.md",
    "defaults/quarto.yml",
    "defaults/releases.json",
    "defaults/theme.json",
    "docs/extension-apis.md",
    "docs/book-contracts.md",
    "schemas/publication.schema.json",
    "_extensions/alkahest-companions/_extension.yml",
    "_extensions/alkahest-generated-lists/_extension.yml",
    "_extensions/alkahest-glossary/_extension.yml",
    "_extensions/alkahest-icons/_extension.yml",
    "_extensions/alkahest-index/_extension.yml",
    "_extensions/alkahest-media/_extension.yml",
    "_extensions/alkahest-notes/_extension.yml",
    "_extensions/alkahest-reuse/_extension.yml",
    "filters/math-alt.lua",
    "filters/pdf-metadata.lua",
    "filters/preview.lua",
    "filters/strip-invalid-alt.lua",
    "latex/before-body.tex",
    "latex/book-layout.tex",
    "latex/title.tex",
    "theme/accessibility-before-body.html",
    "theme/alkahest-epub.css",
    "theme/alkahest-fonts.css",
    "theme/alkahest.scss",
    "src/alkahest/__init__.py",
    "src/alkahest/author_project.py",
    "src/alkahest/process.py",
    "src/alkahest/release_profiles.py",
    "src/alkahest/theme.py",
    "scripts/stage-release.py",
    "scripts/author.py",
    "scripts/sync-release-profiles.py",
    "scripts/sync-theme.py",
    "typst/typst-show.typ"
  ],
  "forbidden_content": [
    "Alkahest Reference Book",
    "A feature specimen for a universal technical-book template",
    "REFERENCE SPECIMEN",
    "half-adder",
    "Answer key: threshold evidence",
    "internal editorial canary and must never appear in a public artifact"
  ]
}
