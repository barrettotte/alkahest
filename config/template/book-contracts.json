{
  "schema_version": 1,
  "contract_version": "0.1.0",
  "schema_standard": "https://json-schema.org/draft/2020-12/schema",
  "layer_order": ["engine-schema", "book-record", "generated-adapter"],
  "domains": [
    {
      "id": "stable-ids",
      "schema": "config/metadata/identities.schema.json",
      "installed_schema": "schemas/identities.schema.json",
      "record": "book/identities.json",
      "validator": "scripts/check-identities.py",
      "composition": "replace",
      "generated_adapter": null
    },
    {
      "id": "edition-manifests",
      "schema": "config/metadata/editions.schema.json",
      "installed_schema": "schemas/editions.schema.json",
      "record": "book/editions.json",
      "validator": "scripts/check-editions.py",
      "composition": "replace",
      "generated_adapter": null
    },
    {
      "id": "publishing-metadata",
      "schema": "config/metadata/publication.schema.json",
      "installed_schema": "schemas/publication.schema.json",
      "record": "book/publication.json",
      "validator": "scripts/check-publication-metadata.py",
      "composition": "replace",
      "generated_adapter": "book/generated/metadata.yml"
    },
    {
      "id": "rights-records",
      "schema": "config/metadata/rights.schema.json",
      "installed_schema": "schemas/rights.schema.json",
      "record": "book/assets.json",
      "validator": "scripts/check-asset-rights.py",
      "composition": "replace",
      "generated_adapter": "book/_build/release/rights-credits.json"
    },
    {
      "id": "accessibility-metadata",
      "schema": "config/metadata/accessibility.schema.json",
      "installed_schema": "schemas/accessibility.schema.json",
      "record": "book/epub-accessibility.json",
      "validator": "scripts/check-epub-accessibility-policy.py",
      "composition": "replace",
      "generated_adapter": null
    },
    {
      "id": "cover-parameters",
      "schema": "config/metadata/covers.schema.json",
      "installed_schema": "schemas/covers.schema.json",
      "record": "config/covers/cover-policy.json",
      "validator": "scripts/check-covers.py",
      "composition": "replace",
      "generated_adapter": null
    },
    {
      "id": "localized-labels",
      "schema": "config/metadata/localized-labels.schema.json",
      "installed_schema": "schemas/localized-labels.schema.json",
      "record": "config/localization/locales.json",
      "validator": "scripts/check-localization.py",
      "composition": "replace",
      "generated_adapter": null
    }
  ]
}
