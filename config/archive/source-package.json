{
  "schema_version": 1,
  "package": {
    "id": "alkahest-reference-book-source",
    "version": "0.1.0",
    "filename": "alkahest-reference-book-source-0.1.0.zip",
    "root_name": "alkahest-reference-book-source-0.1.0",
    "output_root": "book/_build/archive",
    "confidentiality": "private-source-archive",
    "compression": "stored"
  },
  "root_files": [
    ".containerignore",
    ".gitignore",
    ".vale.ini",
    "AGENTS.md",
    "CHANGELOG.md",
    "Containerfile",
    "LICENSE",
    "Makefile",
    "README.md",
    "ROADMAP.md",
    "cspell.json"
  ],
  "source_roots": [
    ".github",
    ".vale",
    "book",
    "config",
    "docs",
    "scripts",
    "template",
    "tests",
    "tools"
  ],
  "exclude_patterns": [
    "(^|/)__pycache__(/|$)",
    "(^|/)node_modules(/|$)",
    "(^|/)\\.venv(/|$)",
    "(^|/)\\.pytest_cache(/|$)",
    "(^|/)\\.ruff_cache(/|$)",
    "(^|/)\\.mypy_cache(/|$)",
    "^book/_build(/|$)",
    "^book/\\.quarto(/|$)",
    "^book/(?:index|reference)_files(/|$)",
    "^book/site_libs(/|$)",
    "^book/theme/fonts(/|$)",
    "^book/icons/.*\\.pdf$",
    "^book/[^/]+\\.(?:epub|html|log|pdf|tex|typ)$",
    "\\.py[co]$",
    "(^|/)(?:\\.DS_Store|Thumbs\\.db)$"
  ],
  "required_roles": {
    "canonical_manuscripts": [
      "book/_quarto.yml",
      "book/editions.json",
      "book/index.qmd",
      "book/releases.json"
    ],
    "metadata": [
      "book/publication.json",
      "book/manifestations.json"
    ],
    "rights_records": [
      "book/assets.json",
      "book/companion.json",
      "book/licenses/CC0-1.0.txt"
    ],
    "dependency_inventory": [
      "Containerfile",
      "docs/toolchain-lock.md",
      "tools/pyproject.toml",
      "tools/uv.lock",
      "tools/writing/package.json",
      "tools/writing/package-lock.json"
    ],
    "lock_data": [
      "book/reproducibility.json",
      "book/identity-lock.json",
      "config/pdf/golden-pages.json"
    ],
    "build_instructions": [
      "README.md",
      "Makefile",
      "docs/toolchain.md"
    ],
    "changelog": [
      "CHANGELOG.md"
    ],
    "redirects": [
      "book/redirects.json"
    ],
    "prior_editions": [
      "book/prior-editions.json"
    ]
  },
  "dependency_files": {
    "container_definition": "Containerfile",
    "human_lock_record": "docs/toolchain-lock.md",
    "python_manifest": "tools/pyproject.toml",
    "python_lock": "tools/uv.lock",
    "writing_manifest": "tools/writing/package.json",
    "writing_lock": "tools/writing/package-lock.json"
  },
  "restoration": {
    "source_check_groups": [
      "execution-policy",
      "reproducibility",
      "publication-metadata",
      "manifestations",
      "metadata-generation",
      "asset-rights",
      "source-archive",
      "template-engine",
      "new-book",
      "theme-defaults",
      "release-profiles",
      "extension-apis",
      "book-contracts",
      "compatibility",
      "editorial-integrity",
      "identities",
      "editions",
      "companions",
      "reuse",
      "citations",
      "glossary",
      "generated-lists",
      "icons",
      "index",
      "notes"
    ],
    "make_target": "help"
  }
}
