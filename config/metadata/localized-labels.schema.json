{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alkahest:schema:localized-labels:1",
  "title": "Alkahest localized labels and script policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonical_locale", "font_family", "locales", "inline_languages", "unsupported_scripts", "source_contract", "rendered_contract"],
  "properties": {
    "schema_version": {"const": 1},
    "canonical_locale": {"$ref": "#/$defs/language"},
    "font_family": {"type": "string", "minLength": 1},
    "locales": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/locale"}},
    "inline_languages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inlineLanguage"}},
    "unsupported_scripts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source_contract": {"type": "object"},
    "rendered_contract": {"type": "object"}
  },
  "$defs": {
    "language": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "locale": {
      "type": "object",
      "required": ["tag", "mode", "direction", "root", "profile", "required_profile_markers"],
      "properties": {
        "tag": {"$ref": "#/$defs/language"},
        "mode": {"enum": ["canonical", "shared-source-smoke", "translated-source"]},
        "direction": {"enum": ["ltr", "rtl"]},
        "root": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "required_profile_markers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "inlineLanguage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "direction", "scripts", "toolchain_packages"],
      "properties": {
        "tag": {"$ref": "#/$defs/language"},
        "direction": {"enum": ["ltr", "rtl"]},
        "scripts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "toolchain_packages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
