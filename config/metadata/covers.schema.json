{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alkahest:schema:covers:1",
  "title": "Alkahest cover parameters",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "output_root", "template", "profiles"],
  "properties": {
    "schema_version": {"const": 1},
    "output_root": {"type": "string", "minLength": 1},
    "template": {"$ref": "#/$defs/template"},
    "profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profile"}}
  },
  "$defs": {
    "decimal": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["printer_template", "binding", "paper", "page_count_policy", "bleed_in", "safe_inset_in", "spine_text_minimum_in", "barcode_safe_area", "finish", "color_space", "press_ready"],
      "properties": {
        "printer_template": {"type": "object", "required": ["id", "revision", "vendor"]},
        "binding": {"enum": ["perfect-bound", "case-bound", "saddle-stitch"]},
        "paper": {"type": "object", "required": ["id", "sheet_caliper_in"]},
        "page_count_policy": {"const": "round-up-even"},
        "bleed_in": {"$ref": "#/$defs/decimal"},
        "safe_inset_in": {"$ref": "#/$defs/decimal"},
        "spine_text_minimum_in": {"$ref": "#/$defs/decimal"},
        "barcode_safe_area": {"type": "object", "required": ["width_in", "height_in", "edge_clearance_in"]},
        "finish": {"enum": ["matte", "gloss", "satin", "uncoated"]},
        "color_space": {"enum": ["sRGB-development", "CMYK-vendor"]},
        "press_ready": {"type": "boolean"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "manifestation", "interior_manifestation"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "manifestation": {"type": "string", "minLength": 1},
        "interior_manifestation": {"type": "string", "minLength": 1}
      }
    }
  }
}
