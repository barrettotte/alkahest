{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alkahest:schema:identities:1",
  "title": "Alkahest stable identity policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "book_id", "canonical_language", "language_variants", "edition_manifests", "companion_registry", "reusable_content_registry", "migrations"],
  "properties": {
    "version": {"const": 1},
    "book_id": {"$ref": "#/$defs/id"},
    "canonical_language": {"$ref": "#/$defs/language"},
    "language_variants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/languageVariant"}},
    "edition_manifests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/jsonPath"}},
    "companion_registry": {"$ref": "#/$defs/jsonPath"},
    "reusable_content_registry": {"$ref": "#/$defs/jsonPath"},
    "migrations": {"type": "array", "items": {"$ref": "#/$defs/migration"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "language": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "jsonPath": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*\\.json$"},
    "languageVariant": {
      "type": "object",
      "required": ["language", "root", "mode"],
      "properties": {
        "language": {"$ref": "#/$defs/language"},
        "root": {"type": "string", "minLength": 1},
        "mode": {"enum": ["canonical", "shared-source", "translated-source"]},
        "profile": {"type": "string", "minLength": 1}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "from", "to", "reason"],
      "properties": {
        "namespace": {"enum": ["content", "glossary", "index", "asset", "reuse"]},
        "from": {"type": "string", "minLength": 1},
        "to": {"type": ["string", "null"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
