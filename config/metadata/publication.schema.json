{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alkahest:schema:publication-metadata:1",
  "title": "Alkahest canonical publication metadata",
  "description": "Work-level editorial, rights, accessibility, and provenance metadata shared by every manifestation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work",
    "contributors",
    "publication",
    "rights",
    "accessibility",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "work": {"$ref": "#/$defs/work"},
    "contributors": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/contributor"}
    },
    "publication": {"$ref": "#/$defs/publication"},
    "rights": {"$ref": "#/$defs/rights"},
    "accessibility": {"$ref": "#/$defs/accessibility"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "nullableString": {
      "type": ["string", "null"]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "title",
        "subtitle",
        "descriptions",
        "series",
        "edition",
        "dates",
        "language",
        "territories",
        "subjects",
        "keywords",
        "audiences"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "status": {
          "enum": ["development", "forthcoming", "published", "withdrawn"]
        },
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"$ref": "#/$defs/nullableString"},
        "descriptions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["short", "long"],
          "properties": {
            "short": {"type": "string", "minLength": 40},
            "long": {"type": "string", "minLength": 100}
          }
        },
        "series": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "number"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "number": {"$ref": "#/$defs/nullableString"}
              }
            }
          ]
        },
        "edition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "number", "statement"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "number": {"type": ["integer", "null"], "minimum": 1},
            "statement": {"type": "string", "minLength": 1}
          }
        },
        "dates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["created", "modified", "publication"],
          "properties": {
            "created": {"$ref": "#/$defs/date"},
            "modified": {"$ref": "#/$defs/date"},
            "publication": {
              "oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]
            }
          }
        },
        "language": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary", "original"],
          "properties": {
            "primary": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z][A-Za-z0-9]{1,7})*$"},
            "original": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z][A-Za-z0-9]{1,7})*$"}
          }
        },
        "territories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(WORLD|[A-Z]{2})$"}
        },
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/subject"}
        },
        "keywords": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/audience"}
        }
      }
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "sort_name", "roles", "affiliation", "orcid"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "display_name": {"type": "string", "minLength": 1},
        "sort_name": {"type": "string", "minLength": 1},
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "author",
              "editor",
              "translator",
              "illustrator",
              "photographer",
              "technical-reviewer",
              "foreword-author",
              "introduction-author",
              "compiler",
              "designer"
            ]
          }
        },
        "affiliation": {"$ref": "#/$defs/nullableString"},
        "orcid": {
          "type": ["string", "null"],
          "pattern": "^https://orcid\\.org/[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "code", "label"],
      "properties": {
        "scheme": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1}
      }
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "label"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "label": {"type": "string", "minLength": 1}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "imprint"],
      "properties": {
        "publisher": {"$ref": "#/$defs/organization"},
        "imprint": {"$ref": "#/$defs/organization"}
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "place", "website"],
      "properties": {
        "name": {"$ref": "#/$defs/nullableString"},
        "place": {"$ref": "#/$defs/nullableString"},
        "website": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["copyright", "statement", "licenses"],
      "properties": {
        "copyright": {
          "type": "object",
          "additionalProperties": false,
          "required": ["year", "holders"],
          "properties": {
            "year": {"type": ["integer", "null"], "minimum": 1000, "maximum": 9999},
            "holders": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "statement": {"type": "string", "minLength": 20},
        "licenses": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/license"}
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "status", "expression", "url", "policy"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "status": {"enum": ["undecided", "selected", "governed-separately"]},
        "expression": {"$ref": "#/$defs/nullableString"},
        "url": {"type": ["string", "null"], "format": "uri"},
        "policy": {"$ref": "#/$defs/nullableString"}
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features", "hazards", "summary", "review"],
      "properties": {
        "features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "hazards": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "summary": {"type": "string", "minLength": 40},
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["standard", "status"],
          "properties": {
            "standard": {"type": "string", "minLength": 1},
            "status": {
              "enum": ["not-started", "pending-manual-review", "conformant", "nonconformant"]
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_statement", "reproducibility_statement", "repository", "policies"],
      "properties": {
        "source_statement": {"type": "string", "minLength": 40},
        "reproducibility_statement": {"type": "string", "minLength": 40},
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["visibility", "url"],
          "properties": {
            "visibility": {"enum": ["private", "public", "archived"]},
            "url": {"type": ["string", "null"], "format": "uri"}
          }
        },
        "policies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reproducibility", "rights", "accessibility"],
          "properties": {
            "reproducibility": {"type": "string", "minLength": 1},
            "rights": {"type": "string", "minLength": 1},
            "accessibility": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
