{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alkahest:schema:accessibility:1",
  "title": "Alkahest EPUB accessibility metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "standard", "language", "claim_status", "discovery", "sections", "landmarks", "pagination"],
  "properties": {
    "schema_version": {"const": 1},
    "standard": {"const": "EPUB Accessibility 1.1"},
    "language": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "claim_status": {"enum": ["pending-manual-review", "conformant", "nonconformant"]},
    "discovery": {"$ref": "#/$defs/discovery"},
    "sections": {"type": "array", "items": {"type": "object", "required": ["id", "epub_type", "role", "body_type"]}},
    "landmarks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["type", "label"]}},
    "pagination": {"type": "object", "required": ["mode", "rationale"]}
  },
  "$defs": {
    "strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access_modes", "access_mode_sufficient", "accessibility_features", "accessibility_hazards", "accessibility_summary"],
      "properties": {
        "access_modes": {"$ref": "#/$defs/strings"},
        "access_mode_sufficient": {"$ref": "#/$defs/strings"},
        "accessibility_features": {"$ref": "#/$defs/strings"},
        "accessibility_hazards": {"$ref": "#/$defs/strings"},
        "accessibility_summary": {"type": "string", "minLength": 1}
      }
    }
  }
}
