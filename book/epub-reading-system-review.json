  "criteria": [
    {
      "id": "import-and-publication-information",
      "instruction": "Import and reopen the EPUB; confirm title, author, language, cover, reading position, and publication information are exposed correctly."
    },
    {
      "id": "navigation-and-landmarks",
      "instruction": "Use the table of contents, landmarks, next and previous navigation, search, glossary, index, and generated lists without dead ends."
    },
    {
      "id": "reading-order-and-structure",
      "instruction": "Confirm headings, lists, notes, figures, tables, appendices, bibliography, and back matter occur in a logical spoken and visual order."
    },
    {
      "id": "keyboard-and-focus",
      "instruction": "Operate the reader and publication in both directions by keyboard, with visible focus, predictable focus order, and no keyboard trap."
    },
    {
      "id": "code-and-tables",
      "instruction": "Inspect code and every table pattern for readable labels, headers, order, local overflow behavior, and retention at enlarged text sizes."
    },
    {
      "id": "images-and-diagrams",
      "instruction": "Confirm images and technical diagrams expose useful alternatives and descriptions without duplicating decorative or positioning content."
    },
    {
      "id": "mathematics",
      "instruction": "Navigate representative MathML with assistive technology and confirm visual layout, speech, copy behavior, and source fallback remain understandable."
    },
    {
      "id": "links-notes-and-backlinks",
      "instruction": "Follow internal and external links, citations, footnotes, semantic notes, and return links while preserving understandable context and focus."
    },
    {
      "id": "language-and-pronunciation",
      "instruction": "Review declared book language and tagged language changes, symbols, abbreviations, and mixed scripts visually and through speech output."
    },
    {
      "id": "assistive-technology",
      "instruction": "Use a current screen reader to inspect names, roles, states, landmarks, headings, alternatives, tables, MathML, and reading progression."
    }
  ],
