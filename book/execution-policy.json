{
  "schema_version": 1,
  "publication": {
    "normal": "static-only",
    "ci": "static-only",
    "release": "static-only",
    "declarative_cells": ["dot", "mermaid"]
  },
  "verification": {
    "enabled": false,
    "network": "disabled",
    "source_mount": "read-only",
    "output_mount": "disposable",
    "dependencies": "locked",
    "cache": "disabled-until-verifier-exists",
    "outputs": "committed-and-drift-checked"
  }
}
