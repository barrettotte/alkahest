    "forbidden_content_patterns": [
      {"label": "Unix home path", "pattern": "/(?:var/)?home/[A-Za-z0-9._-]+/"},
      {"label": "macOS home path", "pattern": "/Users/[A-Za-z0-9._-]+/"},
      {"label": "Windows home path", "pattern": "[A-Za-z]:\\\\Users\\\\[^\\\\]+\\\\"},
      {"label": "container build path", "pattern": "/workspace(?:/|\\b)"},
      {"label": "local file URL", "pattern": "file:///(?:home|Users|var|workspace)/"},
      {"label": "private key", "pattern": "BEGIN (?:RSA |OPENSSH |EC )?PRIVATE KEY"},
      {"label": "AWS access key", "pattern": "AKIA[0-9A-Z]{16}"},
      {"label": "GitHub token", "pattern": "gh[pousr]_[A-Za-z0-9]{20,}"}
    ]
