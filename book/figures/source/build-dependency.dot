// Evaluated Graphviz source; publication uses a deterministic accessible SVG.
digraph build {
  graph [rankdir=LR, bgcolor="transparent", pad="0.2"];
  node [shape=box, style="rounded", fontname="sans-serif"];
  edge [color="#475569"];
  source [label="Manuscript"];
  data [label="Data and assets"];
  validate [label="Validate"];
  render [label="Render"];
  outputs [label="HTML · EPUB · Typst · LuaLaTeX"];
  source -> validate;
  data -> validate;
  validate -> render;
  render -> outputs;
}
