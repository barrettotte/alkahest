{
  "version": "0.2",
  "language": "en-US",
  "useGitignore": false,
  "enabledLanguageIds": ["markdown"],
  "words": [
    "Alkahest",
    "BasedPyright",
    "backmatter",
    "Chemfig",
    "Containerfile",
    "CSpell",
    "EPUBCheck",
    "esterification",
    "MathML",
    "Pandoc",
    "Poppler",
    "Quarto",
    "reflowable",
    "Schemdraw",
    "Typst",
    "Vale",
    "WaveDrom"
  ],
  "dictionaryDefinitions": [
    {
      "name": "alkahest-reference-book",
      "path": "./book/dictionaries/accepted.txt",
      "addWords": true
    }
  ],
  "flagWords": [
    "alot->a lot",
    "backwards-compatible->backward-compatible",
    "Cspell->CSpell",
    "cspell->CSpell",
    "e-book->ebook",
    "Epub->EPUB",
    "epub->EPUB",
    "Github->GitHub",
    "github->GitHub",
    "GraphViz->Graphviz",
    "graphviz->Graphviz",
    "irregardless->regardless",
    "Javascript->JavaScript",
    "javascript->JavaScript",
    "occured->occurred",
    "seperate->separate",
    "teh->the",
    "typst->Typst",
    "vale->Vale"
  ],
  "patterns": [
    {
      "name": "markdown-fenced-code-backticks",
      "pattern": "/^(\\s*)(`{3,})[^\\n]*\\n[\\s\\S]*?^\\1\\2\\s*$/gm"
    },
    {
      "name": "markdown-fenced-code-tildes",
      "pattern": "/^(\\s*)(~{3,})[^\\n]*\\n[\\s\\S]*?^\\1\\2\\s*$/gm"
    },
    {
      "name": "markdown-inline-code",
      "pattern": "/(`+)[^\\n]*?\\1/g"
    },
    {
      "name": "pandoc-display-dollar-math",
      "pattern": "/(?<!\\\\)\\$\\$[\\s\\S]*?(?<!\\\\)\\$\\$/g"
    },
    {
      "name": "pandoc-inline-dollar-math",
      "pattern": "/(?<![\\\\$])\\$(?![\\s$])(?:\\\\.|[^\\n$\\\\])*(?<![\\\\\\s])\\$(?!\\$)/g"
    },
    {
      "name": "pandoc-delimited-math",
      "pattern": "/\\\\(?:\\([\\s\\S]*?\\\\\\)|\\[[\\s\\S]*?\\\\\\])/g"
    },
    {
      "name": "pandoc-citation-and-crossref-key",
      "pattern": "/(?<![A-Za-z0-9_@])@[-A-Za-z0-9_:.\\/]+/g"
    },
    {
      "name": "pandoc-attribute-name",
      "pattern": "/(?:^|[\\s{])(?:[.#][-A-Za-z0-9_:]+|[-A-Za-z0-9_:]+(?=\\s*=))/gm"
    },
    {
      "name": "pandoc-raw-inline-format",
      "pattern": "/\\{=[-A-Za-z0-9_:+.]+\\}/g"
    },
    {
      "name": "quarto-format-attribute",
      "pattern": "/\\bwhen-format\\s*=\\s*[\"'][^\"']+[\"']/g"
    },
    {
      "name": "quarto-shortcode",
      "pattern": "/\\{\\{[<%][\\s\\S]*?[>%]\\}\\}/g"
    },
    {
      "name": "yaml-front-matter-key",
      "pattern": "/^[ \\t-]*[A-Za-z_][A-Za-z0-9_.-]*(?=[ \\t]*:)/gm"
    }
  ],
  "ignoreRegExpList": [
    "Urls",
    "markdown-fenced-code-backticks",
    "markdown-fenced-code-tildes",
    "markdown-inline-code",
    "pandoc-display-dollar-math",
    "pandoc-inline-dollar-math",
    "pandoc-delimited-math",
    "pandoc-citation-and-crossref-key",
    "pandoc-attribute-name",
    "pandoc-raw-inline-format",
    "quarto-format-attribute",
    "quarto-shortcode",
    "yaml-front-matter-key"
  ],
  "overrides": [
    {
      "filename": "**/*.qmd",
      "languageId": "markdown"
    },
    {
      "filename": "book/**",
      "dictionaries": ["alkahest-reference-book"],
      "flagWords": [
        "chemfig->Chemfig",
        "circuitikz->CircuitikZ",
        "kiloohm->kilohm",
        "matplotlib->Matplotlib",
        "rdkit->RDKit",
        "schemedraw->Schemdraw",
        "verilog->Verilog",
        "wavedrom->WaveDrom"
      ]
    }
  ],
  "ignorePaths": [
    "**/.quarto/**",
    "**/.cache/**",
    "**/.venv/**",
    "**/_build/**",
    "**/_freeze/**",
    "**/_site/**",
    "**/*_files/**",
    "**/node_modules/**",
    "**/site_libs/**",
    "book/theme/fonts/**",
    "tests/**",
    "tools/**",
    "AGENTS.md"
  ]
}
