#!/usr/bin/env perl
# Validate local links, anchors, and referenced files in rendered HTML.
use strict;
use warnings;

use Cwd qw(abs_path);
use File::Basename qw(dirname);
use File::Find qw(find);
use File::Spec;

my $root = shift // 'book/_build/html';
my $root_abs = abs_path($root);
die "error: missing HTML output directory: $root\n" if !defined $root_abs;

my @documents;
# Collect all generated documents before validation so cross-page fragments can
# be resolved regardless of filesystem traversal order.
find(
    sub {
        return if !-f $_ || $_ !~ /[.]html?\z/i;
        push @documents, $File::Find::name;
    },
    $root_abs
);
@documents = sort @documents;
die "error: no HTML documents found below $root\n" if !@documents;

my %anchors;
my @errors;
my $local_targets = 0;
my $external_targets = 0;

# Build a document-to-anchor index first. Repeated identifiers are invalid even
# when no current hyperlink happens to target them.
for my $document (@documents) {
    my $contents = read_file($document);
    while ($contents =~ /<([A-Za-z][A-Za-z0-9:-]*)\b([^>]*)>/gs) {
        my $attributes = $2;
        while ($attributes =~ /(?:\A|\s)(?:id|name)\s*=\s*(["'])(.*?)\1/gis) {
            my $anchor = decode_html_entities($2);
            if ($anchors{$document}{$anchor}) {
                push @errors, relative_name($document) . " has duplicate anchor #$anchor";
            }
            $anchors{$document}{$anchor} = 1;
        }
    }
}

# Validate navigation and embedded-resource attributes emitted by Quarto. The
# checker intentionally targets generated, quoted HTML rather than acting as a
# general-purpose fault-tolerant browser parser.
for my $document (@documents) {
    my $contents = read_file($document);
    while ($contents =~ /<([A-Za-z][A-Za-z0-9:-]*)\b([^>]*)>/gs) {
        my ($tag, $attributes) = (lc($1), $2);
        next if $tag !~ /\A(?:a|audio|iframe|img|link|script|source|track|video)\z/;

        while ($attributes =~ /(?:\A|\s)(href|poster|src)\s*=\s*(["'])(.*?)\2/gis) {
            validate_target($document, $3);
        }
    }
}

if (@errors) {
    print STDERR "error: HTML publication validation failed\n";
    print STDERR "  $_\n" for @errors;
    exit 1;
}

printf "ok: HTML links (%d documents; %d local targets; %d external targets skipped offline)\n",
    scalar(@documents), $local_targets, $external_targets;

sub validate_target {
    my ($source, $raw_target) = @_;
    my $target = decode_html_entities($raw_target);
    $target =~ s/^\s+|\s+$//g;
    return if $target eq '';

    # External availability is nondeterministic and requires networking. Count
    # absolute URLs for the report, but leave online checks to a separate gate.
    if ($target =~ m{\A(?:[A-Za-z][A-Za-z0-9+.-]*:|//)}) {
        ++$external_targets;
        return;
    }
    ++$local_targets;

    my ($before_fragment, $fragment) = split /#/, $target, 2;
    my $path = $before_fragment;
    $path =~ s/[?].*\z//;
    $path = decode_uri_component($path);
    $fragment = decode_uri_component($fragment) if defined $fragment;

    my $resolved;
    if ($path eq '') {
        $resolved = $source;
    }
    elsif ($path =~ m{\A/}) {
        $path =~ s{\A/+}{};
        $resolved = File::Spec->catfile($root_abs, split m{/+}, $path);
    }
    else {
        $resolved = File::Spec->catfile(dirname($source), split m{/+}, $path);
    }

    if (-d $resolved) {
        $resolved = File::Spec->catfile($resolved, 'index.html');
    }
    if (!-f $resolved) {
        push @errors, relative_name($source) . " -> $raw_target (missing target)";
        return;
    }

    my $resolved_abs = abs_path($resolved);
    # Resolve symlinks before enforcing the publication boundary so a link
    # cannot appear local while escaping through a generated symlink.
    if (!defined $resolved_abs || index($resolved_abs, "$root_abs/") != 0) {
        push @errors, relative_name($source) . " -> $raw_target (target escapes publication root)";
        return;
    }

    return if !defined $fragment || $fragment eq '';
    return if $resolved_abs !~ /[.]html?\z/i;
    if (!$anchors{$resolved_abs}{$fragment}) {
        push @errors, relative_name($source) . " -> $raw_target (missing fragment)";
    }
}

sub read_file {
    my ($path) = @_;
    open my $handle, '<:raw', $path or die "error: cannot read $path: $!\n";
    local $/;
    return <$handle>;
}

sub relative_name {
    my ($path) = @_;
    return File::Spec->abs2rel($path, $root_abs);
}

sub decode_uri_component {
    my ($value) = @_;
    $value =~ s/%([0-9A-Fa-f]{2})/chr(hex($1))/eg;
    return $value;
}

sub decode_html_entities {
    my ($value) = @_;
    $value =~ s/&#x([0-9A-Fa-f]+);/chr(hex($1))/eg;
    $value =~ s/&#([0-9]+);/chr($1)/eg;
    $value =~ s/&amp;/&/gi;
    $value =~ s/&quot;/"/gi;
    $value =~ s/&apos;/'/gi;
    return $value;
}
