#!/usr/bin/env bash
# Run the complete provider-neutral publishing validation pipeline.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Keep CI policy here rather than in provider YAML so this exact sequence is
# runnable locally. Bootstrap is the sole networked stage; every later wrapper
# explicitly launches its container with networking disabled.
"${script_dir}/bootstrap"
"${script_dir}/quarto" check
"${script_dir}/toolchain-report"
"${script_dir}/check-glyph-coverage"
python3 "${script_dir}/check-execution-policy.py"
python3 "${script_dir}/test-execution-policy.py"
python3 "${script_dir}/check-graphs.py"
"${script_dir}/python-tools" "${script_dir}/check-circuits.py"
"${script_dir}/python-tools" "${script_dir}/check-chemistry.py"
python3 "${script_dir}/check-computing-diagrams.py"
python3 "${script_dir}/check-physics-diagrams.py"
python3 "${script_dir}/check-rich-media.py"
python3 "${script_dir}/check-identities.py"
"${script_dir}/test-identities"
python3 "${script_dir}/check-editions.py"
python3 "${script_dir}/test-editions.py"
python3 "${script_dir}/check-learning.py"
python3 "${script_dir}/test-learning.py"
python3 "${script_dir}/check-companions.py"
python3 "${script_dir}/test-companions.py"
python3 "${script_dir}/check-reuse.py"
python3 "${script_dir}/test-reuse.py"
python3 "${script_dir}/check-citations.py"
"${script_dir}/test-citations"
python3 "${script_dir}/check-generated-lists.py"
"${script_dir}/test-generated-lists"
python3 "${script_dir}/check-glossary.py"
"${script_dir}/test-glossary"
python3 "${script_dir}/check-icons.py"
python3 "${script_dir}/check-index.py"
"${script_dir}/test-index"
python3 "${script_dir}/check-notes.py"
"${script_dir}/test-notes"
"${script_dir}/render" complete
"${script_dir}/check-publication"
"${script_dir}/check-pdf-profiles"
