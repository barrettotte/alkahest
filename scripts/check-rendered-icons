#!/usr/bin/env perl
# Verify rendered icons are hidden from duplicate announcement and followed by text.
use strict;
use warnings;

die "usage: $0 HTML_OR_XHTML...\n" unless @ARGV;

for my $path (@ARGV) {
  open my $input, '<', $path
    or die "error: cannot read rendered icon document $path: $!\n";
  local $/;
  my $markup = <$input>;
  close $input;

  my $declared = () = $markup =~ /<span\b(?=[^>]*class="semantic-icon\s)/g;
  my $checked = 0;
  while ($markup =~ m{
    (<span\b(?=[^>]*class="semantic-icon\s)[^>]*>)
    (.*?)
    </span>
    ((?:(?!</(?:p|div|h[1-6])>).){0,500})
  }gsix) {
    my ($opening, $body, $following) = ($1, $2, $3);
    ++$checked;

    die "error: $path: rendered semantic icon is not aria-hidden\n"
      unless $opening =~ /\baria-hidden="true"/;
    die "error: $path: rendered semantic icon has no canonical identity\n"
      unless $opening =~ /\bdata-icon="[a-z][a-z0-9-]*"/;
    die "error: $path: rendered semantic icon has no registry label metadata\n"
      unless $opening =~ /\bdata-icon-label="[^"]+"/;
    die "error: $path: rendered semantic icon image has no fallback alternative\n"
      unless $body =~ /<img\b(?=[^>]*\balt="[^"]+")[^>]*>/s;

    $following =~ s/<[^>]*>//g;
    $following =~ s/&(?:[A-Za-z][A-Za-z0-9]+|#[0-9]+|#x[0-9A-Fa-f]+);//g;
    die "error: $path: rendered semantic icon is not followed by visible text\n"
      unless $following =~ /[\p{L}\p{N}]/;
  }

  die "error: $path: no rendered semantic icons were found\n" unless $declared;
  die "error: $path: checked $checked of $declared rendered semantic icons\n"
    unless $checked == $declared;
  print "ok: rendered icon accessibility ($path; $checked icons)\n";
}
