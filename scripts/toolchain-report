#!/usr/bin/env bash
# Report pinned sources, tool versions, package revisions, and hashes.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/toolchain.sh
source "${script_dir}/lib/toolchain.sh"

if [[ "$(id -u)" -eq 0 ]]; then
  echo "error: the publishing toolchain must be inspected as a non-root host user" >&2
  exit 1
fi

if ! command -v podman >/dev/null 2>&1; then
  echo "error: Podman is required but was not found" >&2
  exit 1
fi

if ! podman image exists "${ALKAHEST_TOOLCHAIN_IMAGE}"; then
  echo "error: publishing image is not available locally" >&2
  echo "run ./scripts/bootstrap once while connected to the network" >&2
  exit 1
fi

# Inspect the finished image offline rather than repeating version assumptions
# from the Containerfile. This reports both declared source locks and resulting
# installed bytes.
podman run --rm \
  --pull=never \
  --network=none \
  --entrypoint sh \
  "${ALKAHEST_TOOLCHAIN_IMAGE}" \
  -lc '
set -eu

echo "Immutable sources"
printf "  Ubuntu: %s\n" "${ALKAHEST_UBUNTU_SNAPSHOT}"
printf "  Chrome archive: %s\n" "${ALKAHEST_CHROME_ARCHIVE_URL}"
printf "  Chrome archive SHA-256: %s\n" "${ALKAHEST_CHROME_ARCHIVE_SHA256}"
printf "  EPUBCheck archive: %s\n" "${ALKAHEST_EPUBCHECK_ARCHIVE_URL}"
printf "  EPUBCheck archive SHA-256: %s\n" "${ALKAHEST_EPUBCHECK_ARCHIVE_SHA256}"
printf "  Libertinus archive: %s\n" "${ALKAHEST_LIBERTINUS_ARCHIVE_URL}"
printf "  Libertinus archive SHA-256: %s\n" "${ALKAHEST_LIBERTINUS_ARCHIVE_SHA256}"
printf "  Source Code Pro OTF archive: %s\n" "${ALKAHEST_SOURCE_CODE_PRO_OTF_ARCHIVE_URL}"
printf "  Source Code Pro OTF archive SHA-256: %s\n" "${ALKAHEST_SOURCE_CODE_PRO_OTF_ARCHIVE_SHA256}"
printf "  Source Code Pro WOFF2 archive: %s\n" "${ALKAHEST_SOURCE_CODE_PRO_WOFF2_ARCHIVE_URL}"
printf "  Source Code Pro WOFF2 archive SHA-256: %s\n" "${ALKAHEST_SOURCE_CODE_PRO_WOFF2_ARCHIVE_SHA256}"
printf "  uv archive: %s\n" "${ALKAHEST_UV_ARCHIVE_URL}"
printf "  uv archive SHA-256: %s\n" "${ALKAHEST_UV_ARCHIVE_SHA256}"
printf "  Node archive: %s\n" "${ALKAHEST_NODE_ARCHIVE_URL}"
printf "  Node archive SHA-256: %s\n" "${ALKAHEST_NODE_ARCHIVE_SHA256}"
printf "  Vale archive: %s\n" "${ALKAHEST_VALE_ARCHIVE_URL}"
printf "  Vale archive SHA-256: %s\n" "${ALKAHEST_VALE_ARCHIVE_SHA256}"
printf "  TeX Live: %s\n" "${ALKAHEST_TEXLIVE_REPOSITORY}"
printf "  TeX Live database SHA-256: %s\n" "${ALKAHEST_TEXLIVE_TLPDB_SHA256}"

echo "Tools"
printf "  Quarto: "
quarto --version
printf "  Pandoc: "
quarto pandoc --version | sed -n "1s/^pandoc //p"
printf "  Typst: "
quarto typst --version 2>&1 | sed "s/^typst //"
printf "  LuaHBTeX: "
lualatex --version | sed -n "1s/^This is LuaHBTeX, Version //p"
printf "  Chrome for Testing: "
"${QUARTO_CHROMIUM}" --version | sed "s/^Google Chrome for Testing //"
printf "  EPUBCheck: "
java -jar "${EPUBCHECK_JAR}" --version 2>&1 | sed "s/^EPUBCheck v//"
printf "  OpenJDK: "
java -version 2>&1 | sed -n "1s/^openjdk version \"\([^\"]*\)\".*/\1/p"
printf "  Poppler: "
pdfinfo -v 2>&1 | sed -n "1s/^pdfinfo version //p"
printf "  Python: "
python3 --version | sed "s/^Python //"
printf "  Python media environment: "
/opt/alkahest/tools/bin/python --version | sed "s/^Python //"
printf "  uv: "
uv --version | sed "s/^uv //"
printf "  Node: "
node --version | sed "s/^v//"
printf "  npm: "
npm --version
printf "  Vale: "
vale --version | sed "s/^vale version //"
printf "  CSpell: "
cspell --version
printf "  axe-core: "
node -p "require(\"/opt/alkahest/writing/node_modules/axe-core/package.json\").version"
printf "  Schemdraw: "
/opt/alkahest/tools/bin/python -c "import schemdraw; print(schemdraw.__version__)"
printf "  RDKit: "
/opt/alkahest/tools/bin/python -c "from rdkit import rdBase; print(rdBase.rdkitVersion)"
printf "  librsvg: "
rsvg-convert --version | sed "s/^rsvg-convert version //"

echo "Font and TeX packages"
dpkg-query -W fonts-dejavu-core | sed "s/^/  /"
dpkg-query -W openjdk-11-jre-headless | sed "s/^/  /"
dpkg-query -W poppler-utils | sed "s/^/  /"
dpkg-query -W python3 python3-minimal | sed "s/^/  /"
dpkg-query -W librsvg2-bin | sed "s/^/  /"
tlmgr info --only-installed \
  lm lm-math \
  babel-english babel-french babel-german babel-greek babel-hebrew babel-russian \
  hyphen-english hyphen-french hyphen-german hyphen-greek hyphen-russian ruhyphen \
  caption fvextra pgf tcolorbox tikzfill pdfcol fontawesome5 koma-script \
  | grep -E "^(package|revision|cat-version):" \
  | sed "s/^/  /"

echo "Selected fonts"
printf "  Body: "
fc-match --format "%{family[0]} %{style[0]}\n" "Libertinus Serif"
printf "  Display: "
fc-match --format "%{family[0]} %{style[0]}\n" "Libertinus Serif Display"
printf "  Headings: "
fc-match --format "%{family[0]} %{style[0]}\n" "Libertinus Sans"
printf "  Math: "
fc-match --format "%{family[0]} %{style[0]}\n" "Libertinus Math"
printf "  Code: "
fc-match --format "%{family[0]} %{style[0]}\n" "Source Code Pro"

echo "SHA-256"
# Hash the tools and representative font files that materially affect output.
# Package revisions above cover the remaining declared TeX dependencies.
sha256sum \
  "${QUARTO_CHROMIUM}" \
  "${EPUBCHECK_JAR}" \
  /opt/quarto/bin/tools/x86_64/typst \
  /opt/quarto/bin/tools/x86_64/pandoc \
  /usr/local/bin/uv \
  /opt/node/bin/node \
  /usr/local/bin/vale \
  /opt/alkahest/writing/package-lock.json \
  /opt/alkahest/writing/node_modules/cspell/bin.mjs \
  /opt/alkahest/writing/node_modules/axe-core/axe.min.js \
  /opt/alkahest/tools-project/uv.lock \
  /opt/alkahest/tools/lib/python3.12/site-packages/schemdraw/__init__.py \
  /opt/alkahest/tools/lib/python3.12/site-packages/rdkit/Chem/rdchem.so \
  /opt/quarto/share/formats/html/mermaid/mermaid.min.js \
  /opt/quarto/share/js/graphviz-wasm.js \
  /opt/quarto/share/wasm/graphvizlib.wasm \
  /opt/TinyTeX/bin/x86_64-linux/luahbtex \
  /usr/bin/rsvg-convert \
  /usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf \
  /usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf \
  /opt/TinyTeX/texmf-dist/fonts/opentype/public/lm/lmroman10-regular.otf \
  /opt/TinyTeX/texmf-dist/fonts/opentype/public/lm/lmroman10-bold.otf \
  /opt/TinyTeX/texmf-dist/fonts/opentype/public/lm/lmroman10-italic.otf \
  /opt/TinyTeX/texmf-dist/fonts/opentype/public/lm/lmmonolt10-bold.otf \
  /opt/TinyTeX/texmf-dist/fonts/opentype/public/lm-math/latinmodern-math.otf \
  /usr/local/share/fonts/alkahest/libertinus/LibertinusSerif-Regular.otf \
  /usr/local/share/fonts/alkahest/libertinus/LibertinusSerif-Bold.otf \
  /usr/local/share/fonts/alkahest/libertinus/LibertinusSerif-Italic.otf \
  /usr/local/share/fonts/alkahest/libertinus/LibertinusSerif-BoldItalic.otf \
  /usr/local/share/fonts/alkahest/libertinus/LibertinusSerifDisplay-Regular.otf \
  /usr/local/share/fonts/alkahest/libertinus/LibertinusSans-Regular.otf \
  /usr/local/share/fonts/alkahest/libertinus/LibertinusSans-Bold.otf \
  /usr/local/share/fonts/alkahest/libertinus/LibertinusSans-Italic.otf \
  /usr/local/share/fonts/alkahest/libertinus/LibertinusMath-Regular.otf \
  /usr/local/share/fonts/alkahest/source-code-pro/SourceCodePro-Regular.otf \
  /usr/local/share/fonts/alkahest/source-code-pro/SourceCodePro-Bold.otf \
  /usr/local/share/fonts/alkahest/source-code-pro/SourceCodePro-It.otf \
  /usr/local/share/fonts/alkahest/source-code-pro/SourceCodePro-BoldIt.otf
'
