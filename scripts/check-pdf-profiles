#!/usr/bin/env bash
# Validate page dimensions and embedded fonts in every PDF profile.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/toolchain.sh
source "${script_dir}/lib/toolchain.sh"
repo_root="$(alkahest_repo_root)"

# The host-facing invocation reinvokes this same script inside the locked image.
# The guard variable prevents recursion and keeps Poppler out of host/CI setup.
if [[ "${ALKAHEST_PDF_CHECK_IN_CONTAINER:-0}" != "1" ]]; then
  invoking_uid="$(id -u)"
  invoking_gid="$(id -g)"

  if [[ "${invoking_uid}" -eq 0 ]]; then
    echo "error: PDF checks must be run as a non-root host user" >&2
    exit 1
  fi
  if ! command -v podman >/dev/null 2>&1; then
    echo "error: Podman is required but was not found" >&2
    exit 1
  fi
  if ! podman image exists "${ALKAHEST_TOOLCHAIN_IMAGE}"; then
    echo "error: publishing image is not available locally" >&2
    echo "run ./scripts/bootstrap once while connected to the network" >&2
    exit 1
  fi

  exec podman run --rm \
    --pull=never \
    --network=none \
    --userns=keep-id \
    --user "${invoking_uid}:${invoking_gid}" \
    --security-opt label=disable \
    --env ALKAHEST_PDF_CHECK_IN_CONTAINER=1 \
    --volume "${repo_root}:/workspace:ro" \
    --workdir /workspace \
    --entrypoint /workspace/scripts/check-pdf-profiles \
    "${ALKAHEST_TOOLCHAIN_IMAGE}"
fi

for required_command in pdfinfo pdffonts pdftotext; do
  if ! command -v "${required_command}" >/dev/null 2>&1; then
    echo "error: ${required_command} is required for PDF profile checks" >&2
    exit 1
  fi
done

check_pdf() {
  local relative_path="$1"
  local expected_width="$2"
  local expected_height="$3"
  local label="$4"
  local pdf_path="${repo_root}/${relative_path}"
  local actual_width
  local actual_height
  local page_count
  local pdfinfo_output
  local pdfinfo_stderr
  local pdffonts_output
  local pdf_text
  local pdf_bbox
  local pdftotext_stderr
  local appendix_a_marker
  local appendix_b_marker
  local equation_marker
  local math_equation_marker
  local required_font
  local required_marker
  local recto_description
  local recto_marker
  local marker_page
  local boundary
  local boundary_start_page
  local boundary_end_page
  local split_boundary_found=0
  local blank_page_text
  local diagnostic
  local unexpected_diagnostic=0
  local -a pdf_pages

  if [[ ! -f "${pdf_path}" ]]; then
    echo "error: missing ${label}: ${relative_path}" >&2
    return 1
  fi

  # Poppler 0.86 predates Typst's tagged-PDF output and misdiagnoses the valid
  # boolean MarkInfo/Suspects entry. Ignore only that exact Typst diagnostic;
  # any different parser message still fails validation.
  pdfinfo_stderr="$(mktemp)"
  if ! pdfinfo_output="$(pdfinfo "${pdf_path}" 2>"${pdfinfo_stderr}")"; then
    echo "error: pdfinfo could not inspect ${label}" >&2
    sed 's/^/  /' "${pdfinfo_stderr}" >&2
    rm "${pdfinfo_stderr}"
    return 1
  fi
  while IFS= read -r diagnostic; do
    [[ -z "${diagnostic}" ]] && continue
    if [[ "${label}" == Typst* \
      && "${diagnostic}" == "Syntax Error: Suspects object is wrong type (boolean)" ]]
    then
      continue
    fi
    echo "error: pdfinfo reported an unexpected diagnostic for ${label}" >&2
    echo "  ${diagnostic}" >&2
    unexpected_diagnostic=1
  done <"${pdfinfo_stderr}"
  rm "${pdfinfo_stderr}"
  if [[ "${unexpected_diagnostic}" -ne 0 ]]; then
    return 1
  fi

  read -r actual_width actual_height < <(
    awk '/^Page size:/ { print $3, $5; exit }' <<<"${pdfinfo_output}"
  )
  page_count="$(awk '/^Pages:/ { print $2; exit }' <<<"${pdfinfo_output}")"

  if ! awk \
    -v actual_width="${actual_width}" \
    -v actual_height="${actual_height}" \
    -v expected_width="${expected_width}" \
    -v expected_height="${expected_height}" \
    'BEGIN {
      width_delta = actual_width - expected_width
      height_delta = actual_height - expected_height
      if (width_delta < 0) width_delta = -width_delta
      if (height_delta < 0) height_delta = -height_delta
      exit !(width_delta <= 0.1 && height_delta <= 0.1)
    }'
  then
    echo "error: ${label} is ${actual_width} x ${actual_height} points; expected ${expected_width} x ${expected_height}" >&2
    return 1
  fi

  if (( page_count < 30 )); then
    echo "error: ${label} has ${page_count} pages; the specimen must retain the Phase 2 minimum of 30" >&2
    return 1
  fi

  # A complete text stream can still hide visible clipping. Inspect Poppler's
  # positioned word boxes and reject any text that crosses the physical page.
  # Blank and image-only pages legitimately produce the exact diagnostic below.
  pdf_bbox="$(mktemp)"
  pdftotext_stderr="$(mktemp)"
  if ! pdftotext -bbox "${pdf_path}" "${pdf_bbox}" 2>"${pdftotext_stderr}"; then
    echo "error: pdftotext could not extract positioned text from ${label}" >&2
    sed 's/^/  /' "${pdftotext_stderr}" >&2
    rm "${pdf_bbox}" "${pdftotext_stderr}"
    return 1
  fi
  while IFS= read -r diagnostic; do
    [[ -z "${diagnostic}" || "${diagnostic}" == "no word list" ]] && continue
    echo "error: positioned-text extraction reported an unexpected diagnostic for ${label}" >&2
    echo "  ${diagnostic}" >&2
    unexpected_diagnostic=1
  done <"${pdftotext_stderr}"
  if [[ "${unexpected_diagnostic}" -ne 0 ]]; then
    rm "${pdf_bbox}" "${pdftotext_stderr}"
    return 1
  fi
  if ! perl -ne '
    if (/<page width="([0-9.]+)"/) {
      $page_width = $1;
    }
    while (/<word xMin="([0-9.-]+)"[^>]*xMax="([0-9.-]+)"/g) {
      if ($1 < -0.1 || $2 > $page_width + 0.1) {
        printf STDERR "word box %.3f..%.3f crosses %.3f-point page\n", $1, $2, $page_width;
        $failed = 1;
      }
    }
    END { exit($failed ? 1 : 0) }
  ' "${pdf_bbox}"
  then
    echo "error: ${label} contains text outside the physical page" >&2
    rm "${pdf_bbox}" "${pdftotext_stderr}"
    return 1
  fi
  rm "${pdf_bbox}" "${pdftotext_stderr}"

  # Require both correct packaging and the selected families. Otherwise a
  # missing font could pass by silently falling back to a bundled backend face.
  pdffonts_output="$(pdffonts "${pdf_path}")"
  if ! awk '
    NR > 2 && ($(NF - 4) != "yes" || $(NF - 3) != "yes") { failed = 1 }
    END { exit failed }
  ' <<<"${pdffonts_output}"
  then
    echo "error: ${label} contains a font that is not embedded and subset" >&2
    return 1
  fi

  for required_font in \
    LibertinusSerif-Regular \
    LibertinusSerif-Bold \
    LibertinusSerif-Italic \
    LibertinusSerif-BoldItalic \
    LibertinusSerifDisplay-Regular \
    LibertinusSans-Bold \
    LibertinusMath-Regular \
    SourceCodePro-Regular \
    SourceCodePro-Bold
  do
    if [[ "${pdffonts_output}" != *"${required_font}"* ]]; then
      echo "error: ${label} does not embed selected face ${required_font}" >&2
      return 1
    fi
  done

  # Text extraction is not a complete visual test, but it catches dropped
  # template pages and broken book-division transforms in every trim profile.
  mapfile -d $'\f' -t pdf_pages < <(pdftotext -layout "${pdf_path}" -)
  if [[ "${#pdf_pages[@]}" -ne "${page_count}" ]]; then
    echo "error: ${label} yielded ${#pdf_pages[@]} extracted pages; expected ${page_count}" >&2
    return 1
  fi
  # Use Poppler's reading-order extraction for literal marker checks; layout
  # extraction may insert discretionary visual hyphens into otherwise intact text.
  pdf_text="$(pdftotext "${pdf_path}" - | awk 'BEGIN { ORS = " " } { print }')"
  for required_marker in \
    "Publication data" \
    "For the readers who build things to understand them." \
    "Foundations" \
    "Core feature specimen" \
    "A deliberately long chapter title for testing wrapping" \
    "Page continuity after a pagination stress chapter" \
    "Layout acceptance record" \
    "Boundary Alpha begins" \
    "Boundary Lima ends" \
    "Page-system checklist" \
    "Format behavior" \
    "Language and writing-system specimen" \
    "English: The characteristically interdisciplinary electromechanical laboratory" \
    "Français" \
    "Deutsch: Die Donaudampfschifffahrtsgesellschaft" \
    "Greek: Η τεχνολογία εξελίσσεται μέσα από τη γνώση." \
    "Cyrillic: Технология развивается благодаря знаниям." \
    "Hebrew:" \
    "Contents" \
    "Heading hierarchy" \
    "Numbered subsection with a descriptive title" \
    "Detail heading excluded from numbering and contents" \
    "Section 1.1" \
    "Section 1.1.1" \
    "Figure 1.1" \
    "Table 1.1" \
    "Listing 1.1" \
    "Code blocks and executable-example presentation" \
    "counter.py" \
    "status.py" \
    "Clamp untrusted input before applying the thresholds." \
    "ALKAHEST_LONG_LINE_BEGIN" \
    "LONG_LINE_END" \
    "counter.patch" \
    "python3 counter.py" \
    "checksum.py" \
    "standard output" \
    "Mathematical notation and reasoning" \
    "Aligned equations" \
    "Cases and custom operators" \
    "Matrices and vectors" \
    "Theorem 6.1" \
    "Saturation bounds" \
    "Proof" \
    "Figures and visual evidence" \
    "Captions, alternatives, and provenance" \
    "Subfigures and panel references" \
    "Full-width and output-specific art" \
    "Figure 7.1" \
    "Figure 7.2" \
    "Figure 7.2a" \
    "Figure 7.2b" \
    "Figure 7.3" \
    "Source: original Alkahest fixture" \
    "print edition"
  do
    if [[ "${pdf_text}" != *"${required_marker}"* ]]; then
      echo "error: ${label} is missing required marker: ${required_marker}" >&2
      return 1
    fi
  done
  if [[ "${label}" == Typst* ]]; then
    appendix_a_marker="A. Page-system checklist"
    appendix_b_marker="B. Format behavior"
    equation_marker="Equation (1.1)"
    math_equation_marker="Equation (6.3)"
  else
    appendix_a_marker="A Page-system checklist"
    appendix_b_marker="B Format behavior"
    equation_marker="Equation 1.1"
    math_equation_marker="Equation 6.3"
  fi
  for required_marker in \
    "${appendix_a_marker}" \
    "${appendix_b_marker}" \
    "${equation_marker}" \
    "${math_equation_marker}"
  do
    if [[ "${pdf_text}" != *"${required_marker}"* ]]; then
      echo "error: ${label} is missing backend marker: ${required_marker}" >&2
      return 1
    fi
  done
  if [[ "${pdf_text}" == *"1.1.1.1"* ]]; then
    echo "error: ${label} incorrectly numbers the H4 detail heading" >&2
    return 1
  fi
  if [[ "${pdf_text}" == *"screen edition"* ]]; then
    echo "error: ${label} contains the screen-only figure variant" >&2
    return 1
  fi

  # Physical PDF page 1 is a recto regardless of the displayed folio. Locate
  # unique opening prose so contents entries cannot produce a false match.
  find_marker_page() {
    local marker="$1"
    local page_index
    local normalized_page
    for page_index in "${!pdf_pages[@]}"; do
      normalized_page="$(tr '\n\r\t' '   ' <<<"${pdf_pages[${page_index}]}" | tr -s ' ')"
      if [[ "${normalized_page}" == *"${marker}"* ]]; then
        printf '%s\n' "$((page_index + 1))"
        return 0
      fi
    done
    return 1
  }

  while IFS='|' read -r recto_description recto_marker; do
    if ! marker_page="$(find_marker_page "${recto_marker}")"; then
      echo "error: ${label} is missing recto marker for ${recto_description}: ${recto_marker}" >&2
      return 1
    fi
    if (( marker_page % 2 == 0 )); then
      echo "error: ${label} places ${recto_description} on physical page ${marker_page}, a verso" >&2
      return 1
    fi
  done <<'RECTO_MARKERS'
reference chapter|This chapter begins the cross-format test corpus.
layout-stress chapter|This chapter is a pagination stress specimen
continuity chapter|This follow-on chapter proves
acceptance chapter|This final layout chapter records
code-block chapter|This chapter defines how source code, terminal transcripts, patches
math chapter|This chapter defines the shared authoring contract for mathematical
figure chapter|This chapter defines the shared contract for authored images
appendix A|This appendix makes the first appendix opener
appendix B|This second appendix proves
appendix C|This appendix exercises language metadata
RECTO_MARKERS

  # Page 4 is deliberately reserved after the dedication. Zero extracted text
  # proves that no folio, running head, rule label, or placeholder leaked onto it.
  blank_page_text="$(tr -d '[:space:]' <<<"${pdf_pages[3]}")"
  if [[ -n "${blank_page_text}" ]]; then
    echo "error: ${label} physical page 4 is not the required furniture-free blank verso" >&2
    return 1
  fi

  # Ensure the corpus actually exercises cross-page paragraph layout. The
  # explicit backend widow/orphan rules and visual review cover line quality.
  for boundary in Alpha Bravo Charlie Delta Echo Foxtrot Golf Hotel India Juliett Kilo Lima; do
    boundary_start_page="$(find_marker_page "Boundary ${boundary} begins")"
    boundary_end_page="$(find_marker_page "Boundary ${boundary} ends")"
    if [[ "${boundary_start_page}" -ne "${boundary_end_page}" ]]; then
      if (( boundary_end_page - boundary_start_page != 1 )); then
        echo "error: ${label} splits Boundary ${boundary} across more than two pages" >&2
        return 1
      fi
      split_boundary_found=1
    fi
  done
  if [[ "${split_boundary_found}" -ne 1 ]]; then
    echo "error: ${label} does not exercise a cross-page boundary paragraph" >&2
    return 1
  fi

  echo "ok: ${label} (${actual_width} x ${actual_height} points; ${page_count} pages; physical containment, code/math/figure contracts, fonts, language scripts, recto/blank-page policy, pagination stress, headings, and references verified)"
}

check_pdf "book/_build/print/7x10/typst/Alkahest-Reference-Book.pdf" 504 720 "Typst 7 x 10"
check_pdf "book/_build/print/7x10/latex/Alkahest-Reference-Book.pdf" 504 720 "LuaLaTeX 7 x 10"
check_pdf "book/_build/print/6x9/typst/Alkahest-Reference-Book.pdf" 432 648 "Typst 6 x 9"
check_pdf "book/_build/print/6x9/latex/Alkahest-Reference-Book.pdf" 432 648 "LuaLaTeX 6 x 9"
check_pdf "book/_build/review/letter/typst/Alkahest-Reference-Book.pdf" 612 792 "Typst Letter review"
check_pdf "book/_build/review/letter/latex/Alkahest-Reference-Book.pdf" 612 792 "LuaLaTeX Letter review"
