#!/usr/bin/env bash
# Validate page dimensions and embedded fonts in every PDF profile.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/toolchain.sh
source "${script_dir}/lib/toolchain.sh"
repo_root="$(alkahest_repo_root)"

# The host-facing invocation reinvokes this same script inside the locked image.
# The guard variable prevents recursion and keeps Poppler out of host/CI setup.
if [[ "${ALKAHEST_PDF_CHECK_IN_CONTAINER:-0}" != "1" ]]; then
  invoking_uid="$(id -u)"
  invoking_gid="$(id -g)"

  if [[ "${invoking_uid}" -eq 0 ]]; then
    echo "error: PDF checks must be run as a non-root host user" >&2
    exit 1
  fi
  if ! command -v podman >/dev/null 2>&1; then
    echo "error: Podman is required but was not found" >&2
    exit 1
  fi
  if ! podman image exists "${ALKAHEST_TOOLCHAIN_IMAGE}"; then
    echo "error: publishing image is not available locally" >&2
    echo "run ./scripts/bootstrap once while connected to the network" >&2
    exit 1
  fi

  exec podman run --rm \
    --pull=never \
    --network=none \
    --userns=keep-id \
    --user "${invoking_uid}:${invoking_gid}" \
    --security-opt label=disable \
    --env ALKAHEST_PDF_CHECK_IN_CONTAINER=1 \
    --volume "${repo_root}:/workspace:ro" \
    --workdir /workspace \
    --entrypoint /workspace/scripts/check-pdf-profiles \
    "${ALKAHEST_TOOLCHAIN_IMAGE}"
fi

for required_command in pdfinfo pdffonts pdftotext; do
  if ! command -v "${required_command}" >/dev/null 2>&1; then
    echo "error: ${required_command} is required for PDF profile checks" >&2
    exit 1
  fi
done

check_pdf() {
  local relative_path="$1"
  local expected_width="$2"
  local expected_height="$3"
  local label="$4"
  local pdf_path="${repo_root}/${relative_path}"
  local actual_width
  local actual_height
  local pdfinfo_output
  local pdfinfo_stderr
  local pdffonts_output
  local pdf_text
  local appendix_a_marker
  local appendix_b_marker
  local equation_marker
  local required_font
  local required_marker
  local diagnostic
  local unexpected_diagnostic=0

  if [[ ! -f "${pdf_path}" ]]; then
    echo "error: missing ${label}: ${relative_path}" >&2
    return 1
  fi

  # Poppler 0.86 predates Typst's tagged-PDF output and misdiagnoses the valid
  # boolean MarkInfo/Suspects entry. Ignore only that exact Typst diagnostic;
  # any different parser message still fails validation.
  pdfinfo_stderr="$(mktemp)"
  if ! pdfinfo_output="$(pdfinfo "${pdf_path}" 2>"${pdfinfo_stderr}")"; then
    echo "error: pdfinfo could not inspect ${label}" >&2
    sed 's/^/  /' "${pdfinfo_stderr}" >&2
    rm "${pdfinfo_stderr}"
    return 1
  fi
  while IFS= read -r diagnostic; do
    [[ -z "${diagnostic}" ]] && continue
    if [[ "${label}" == Typst* \
      && "${diagnostic}" == "Syntax Error: Suspects object is wrong type (boolean)" ]]
    then
      continue
    fi
    echo "error: pdfinfo reported an unexpected diagnostic for ${label}" >&2
    echo "  ${diagnostic}" >&2
    unexpected_diagnostic=1
  done <"${pdfinfo_stderr}"
  rm "${pdfinfo_stderr}"
  if [[ "${unexpected_diagnostic}" -ne 0 ]]; then
    return 1
  fi

  read -r actual_width actual_height < <(
    awk '/^Page size:/ { print $3, $5; exit }' <<<"${pdfinfo_output}"
  )

  if ! awk \
    -v actual_width="${actual_width}" \
    -v actual_height="${actual_height}" \
    -v expected_width="${expected_width}" \
    -v expected_height="${expected_height}" \
    'BEGIN {
      width_delta = actual_width - expected_width
      height_delta = actual_height - expected_height
      if (width_delta < 0) width_delta = -width_delta
      if (height_delta < 0) height_delta = -height_delta
      exit !(width_delta <= 0.1 && height_delta <= 0.1)
    }'
  then
    echo "error: ${label} is ${actual_width} x ${actual_height} points; expected ${expected_width} x ${expected_height}" >&2
    return 1
  fi

  # Require both correct packaging and the selected families. Otherwise a
  # missing font could pass by silently falling back to a bundled backend face.
  pdffonts_output="$(pdffonts "${pdf_path}")"
  if ! awk '
    NR > 2 && ($(NF - 4) != "yes" || $(NF - 3) != "yes") { failed = 1 }
    END { exit failed }
  ' <<<"${pdffonts_output}"
  then
    echo "error: ${label} contains a font that is not embedded and subset" >&2
    return 1
  fi

  for required_font in \
    LibertinusSerif-Regular \
    LibertinusSerif-Bold \
    LibertinusSerif-Italic \
    LibertinusSerif-BoldItalic \
    LibertinusSerifDisplay-Regular \
    LibertinusSans-Bold \
    LibertinusMath-Regular \
    SourceCodePro-Regular \
    SourceCodePro-Bold
  do
    if [[ "${pdffonts_output}" != *"${required_font}"* ]]; then
      echo "error: ${label} does not embed selected face ${required_font}" >&2
      return 1
    fi
  done

  # Text extraction is not a complete visual test, but it catches dropped
  # template pages and broken book-division transforms in every trim profile.
  pdf_text="$(pdftotext "${pdf_path}" - | awk 'BEGIN { ORS = " " } { print }')"
  for required_marker in \
    "Publication data" \
    "For the readers who build things to understand them." \
    "Foundations" \
    "Core feature specimen" \
    "Page-system checklist" \
    "Format behavior" \
    "Contents" \
    "Heading hierarchy" \
    "Numbered subsection with a descriptive title" \
    "Detail heading excluded from numbering and contents" \
    "Section 1.1" \
    "Section 1.1.1" \
    "Figure 1.1" \
    "Table 1.1" \
    "Listing 1.1"
  do
    if [[ "${pdf_text}" != *"${required_marker}"* ]]; then
      echo "error: ${label} is missing required marker: ${required_marker}" >&2
      return 1
    fi
  done
  if [[ "${label}" == Typst* ]]; then
    appendix_a_marker="A. Page-system checklist"
    appendix_b_marker="B. Format behavior"
    equation_marker="Equation (1.1)"
  else
    appendix_a_marker="A Page-system checklist"
    appendix_b_marker="B Format behavior"
    equation_marker="Equation 1.1"
  fi
  for required_marker in \
    "${appendix_a_marker}" \
    "${appendix_b_marker}" \
    "${equation_marker}"
  do
    if [[ "${pdf_text}" != *"${required_marker}"* ]]; then
      echo "error: ${label} is missing backend marker: ${required_marker}" >&2
      return 1
    fi
  done
  if [[ "${pdf_text}" == *"1.1.1.1"* ]]; then
    echo "error: ${label} incorrectly numbers the H4 detail heading" >&2
    return 1
  fi

  echo "ok: ${label} (${actual_width} x ${actual_height} points; fonts, page system, headings, and references verified)"
}

check_pdf "book/_build/print/7x10/typst/Alkahest-Reference-Book.pdf" 504 720 "Typst 7 x 10"
check_pdf "book/_build/print/7x10/latex/Alkahest-Reference-Book.pdf" 504 720 "LuaLaTeX 7 x 10"
check_pdf "book/_build/print/6x9/typst/Alkahest-Reference-Book.pdf" 432 648 "Typst 6 x 9"
check_pdf "book/_build/print/6x9/latex/Alkahest-Reference-Book.pdf" 432 648 "LuaLaTeX 6 x 9"
check_pdf "book/_build/review/letter/typst/Alkahest-Reference-Book.pdf" 612 792 "Typst Letter review"
check_pdf "book/_build/review/letter/latex/Alkahest-Reference-Book.pdf" 612 792 "LuaLaTeX Letter review"
