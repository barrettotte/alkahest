#!/usr/bin/env perl
# Generate a disposable Quarto project with one complete appendix-edition manifest.
use strict;
use warnings;
use Cwd qw(abs_path);
use File::Path qw(make_path remove_tree);
use FindBin qw($Bin);
use lib "$Bin/lib";
use Alkahest::AppendixEditions qw(load_appendix_editions);

my $edition_name = shift @ARGV // '';
die "usage: $0 EDITION\n" if @ARGV || $edition_name !~ /^[a-z][a-z0-9-]*$/;

my $repo_root = abs_path("$Bin/..");
my $book_root = "$repo_root/book";
my $registry = load_appendix_editions("$book_root/appendix-editions.json");
my $edition = $registry->{editions}{$edition_name}
  or die "error: unknown appendix edition '$edition_name'\n";
my $stage_root = "$book_root/_build/staging/editions/$edition_name";
my $staging_parent = "$book_root/_build/staging/editions";
die "error: unsafe edition staging path\n"
  if index($stage_root, "$staging_parent/") != 0;

remove_tree($stage_root) if -e $stage_root || -l $stage_root;
make_path($stage_root);

opendir my $book, $book_root or die "error: cannot read $book_root: $!\n";
my @entries = readdir $book;
closedir $book;
my %skip = map { $_ => 1 } qw(. .. .quarto _build _quarto.yml);
for my $entry (sort @entries) {
  next if $skip{$entry};
  next if $entry eq 'site_libs' || $entry =~ /_files$/;
  next if $entry =~ /^(?:Alkahest-Reference-Book\.(?:epub|pdf)|index\.(?:html|log|tex|typ)|reference\.html|references\.html)$/;
  my $target = "../../../../$entry";
  symlink $target, "$stage_root/$entry"
    or die "error: cannot link edition input $entry: $!\n";
}

open my $base_handle, '<:encoding(UTF-8)', "$book_root/_quarto.yml"
  or die "error: cannot read canonical Quarto config: $!\n";
local $/;
my $config = <$base_handle>;
close $base_handle;

my $appendices = "  appendices:\n";
for my $group (@{ $edition->{groups} }) {
  $appendices .= qq{    - part: "$group->{part}"\n      chapters:\n};
  for my $source_id (@{ $group->{chapters} }) {
    $appendices .= "        - $registry->{sources}{$source_id}{path}\n";
  }
}
$appendices .= "\n";
die "error: canonical Quarto config has no replaceable appendices block\n"
  if $config !~ s/^  appendices:\n.*?(?=^\S)/$appendices/ms;
$config =~ s{\.\./scripts/}{../../../../../scripts/}g;

open my $config_handle, '>:encoding(UTF-8)', "$stage_root/_quarto.yml"
  or die "error: cannot write staged Quarto config: $!\n";
print {$config_handle} $config;
close $config_handle;

open my $profile_handle, '>:encoding(UTF-8)',
  "$stage_root/_quarto-edition-$edition_name.yml"
  or die "error: cannot write staged edition profile: $!\n";
print {$profile_handle} "# Generated from appendix-editions.json; do not edit.\n";
print {$profile_handle} "alkahest:\n  appendix-edition: $edition_name\n";
close $profile_handle;

print "$stage_root\n";
