#!/usr/bin/env perl
# Generate a disposable Quarto project containing exactly one book edition.
use strict;
use warnings;
use Cwd qw(abs_path);
use File::Basename qw(dirname);
use File::Path qw(make_path remove_tree);
use File::Spec;
use FindBin qw($Bin);
use lib "$Bin/lib";
use Alkahest::Editions qw(edition_paths load_editions render_book_structure);

my $edition_name = shift @ARGV // '';
die "usage: $0 EDITION\n" if @ARGV || $edition_name !~ /^[a-z][a-z0-9-]*$/;

my $repo_root = abs_path("$Bin/..");
my $book_root = "$repo_root/book";
my $registry = load_editions("$book_root/editions.json");
my $edition = $registry->{editions}{$edition_name}
  or die "error: unknown edition '$edition_name'\n";
my $stage_root = "$book_root/_build/staging/editions/$edition_name";
my $staging_parent = "$book_root/_build/staging/editions";
die "error: unsafe edition staging path\n"
  if index($stage_root, "$staging_parent/") != 0;

remove_tree($stage_root) if -e $stage_root || -l $stage_root;
make_path($stage_root);

opendir my $book, $book_root or die "error: cannot read $book_root: $!\n";
my @entries = readdir $book;
closedir $book;
my %registered_top = map {
  my ($top) = split m{/}, $_, 2;
  $top => 1;
} map { $_->{path} } values %{ $registry->{sources} };
my %skip = map { $_ => 1 } qw(. .. .quarto _build _quarto.yml);
for my $entry (sort @entries) {
  next if $skip{$entry};
  # Registered manuscript paths are linked individually below. Never link a
  # source directory wholesale: that would copy private or omitted material
  # into a public staging project even if Quarto did not render it.
  next if $registered_top{$entry};
  next if $entry eq 'site_libs' || $entry =~ /_files$/;
  next if $entry =~ /^(?:Alkahest-Reference-Book\.(?:epub|pdf)|index\.(?:html|log|tex|typ)|reference\.html|references\.html)$/;
  my $target = "../../../../$entry";
  symlink $target, "$stage_root/$entry"
    or die "error: cannot link edition input $entry: $!\n";
}

for my $source_path (edition_paths($registry, $edition_name)) {
  my $source = "$book_root/$source_path";
  die "error: edition source does not exist: $source_path\n" if !-f $source;
  my $destination = "$stage_root/$source_path";
  make_path(dirname($destination));
  my $target = File::Spec->abs2rel($source, dirname($destination));
  symlink $target, $destination
    or die "error: cannot link selected edition source $source_path: $!\n";
}

open my $base_handle, '<:encoding(UTF-8)', "$book_root/_quarto.yml"
  or die "error: cannot read canonical Quarto config: $!\n";
local $/;
my $config = <$base_handle>;
close $base_handle;

my $structure = render_book_structure($registry, $edition_name);
die "error: canonical Quarto config has no replaceable book structure\n"
  if $config !~ s/^  chapters:\n.*?(?=^\S)/$structure/ms;
$config =~ s{\.\./scripts/}{../../../../../scripts/}g;

open my $config_handle, '>:encoding(UTF-8)', "$stage_root/_quarto.yml"
  or die "error: cannot write staged Quarto config: $!\n";
print {$config_handle} $config;
close $config_handle;

open my $profile_handle, '>:encoding(UTF-8)',
  "$stage_root/_quarto-edition-$edition_name.yml"
  or die "error: cannot write staged edition profile: $!\n";
print {$profile_handle} "# Generated from editions.json; do not edit.\n";
print {$profile_handle} "alkahest:\n  content-edition: $edition_name\n";
close $profile_handle;

print "$stage_root\n";
