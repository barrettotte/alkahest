#!/usr/bin/env perl
# Validate semantic note identity, definitions, sources, repeats, and apparatus.
use strict;
use warnings;
use Cwd qw(abs_path);
use File::Find qw(find);
use FindBin qw($Bin);

my $repo_root = abs_path("$Bin/..");
my $book_root = $ENV{ALKAHEST_NOTES_BOOK_ROOT} // "$repo_root/book";
$book_root = abs_path($book_root)
  or die "error: notes book root does not exist\n";
my $registry_path = "$book_root/notes.yml";

open my $registry, '<', $registry_path
  or die "error: cannot read notes registry $registry_path: $!\n";
my @registry_lines = <$registry>;
close $registry;

my ($version, $section, $current);
my (@order, %entries, %order_seen);
for (my $index = 0; $index < @registry_lines; ++$index) {
  my $line_number = $index + 1;
  my $line = $registry_lines[$index];
  chomp $line;
  next if $line =~ /^\s*(?:#.*)?$/;
  if ($line =~ /^version: ([0-9]+)$/) {
    die "error: $registry_path:$line_number: duplicate version\n"
      if defined $version;
    $version = $1;
    next;
  }
  if ($line eq 'order:' || $line eq 'notes:') {
    $section = substr($line, 0, -1);
    $current = undef;
    next;
  }
  if (($section // '') eq 'order' && $line =~ /^  - ([a-z][a-z0-9-]*)$/) {
    my $name = $1;
    die "error: $registry_path:$line_number: duplicate note in order: $name\n"
      if $order_seen{$name}++;
    push @order, $name;
    next;
  }
  if (($section // '') eq 'notes' && $line =~ /^  ([a-z][a-z0-9-]*):$/) {
    $current = $1;
    die "error: $registry_path:$line_number: duplicate note ID: $current\n"
      if exists $entries{$current};
    $entries{$current} = { line => $line_number };
    next;
  }
  die "error: $registry_path:$line_number: field appears before a note ID\n"
    unless ($section // '') eq 'notes' && defined $current;
  if ($line =~ /^    (source|repeat|references): (\S.*)$/) {
    my ($field, $value) = ($1, $2);
    die "error: $registry_path:$line_number: duplicate $field for $current\n"
      if exists $entries{$current}{$field};
    $entries{$current}{$field} = $value;
    next;
  }
  die "error: $registry_path:$line_number: unsupported notes syntax: $line\n";
}

die "error: notes registry version must be 1\n"
  unless defined $version && $version == 1;
die "error: notes registry has no ordered notes\n" unless @order;
die "error: notes order and mapping contain different entry counts\n"
  unless @order == keys %entries;
for my $name (@order) {
  die "error: notes order references unknown note $name\n"
    unless exists $entries{$name};
}

for my $name (sort keys %entries) {
  my $entry = $entries{$name};
  die "error: note $name is absent from order\n" unless $order_seen{$name};
  die "error: note $name has invalid source\n"
    unless ($entry->{source} // '')
      =~ m{^(?:appendices/)?[a-z0-9][a-z0-9-]*\.qmd$};
  die "error: note $name has unsupported repeat policy\n"
    unless ($entry->{repeat} // '') eq 'once'
      || ($entry->{repeat} // '') eq 'reuse';
  die "error: note $name has invalid reference count\n"
    unless ($entry->{references} // '') =~ /^[1-9][0-9]*$/;
  die "error: note $name uses repeat=once with more than one reference\n"
    if $entry->{repeat} eq 'once' && $entry->{references} != 1;
}

my @sources;
find(
  {
    wanted => sub {
      return unless -f $_ && /\.qmd\z/;
      return if $File::Find::name =~ m{/(?:\.quarto|_build)/};
      push @sources, $File::Find::name;
    },
    no_chdir => 1,
  },
  $book_root,
);

my (%definitions, %references, %reference_sources);
my $placeholders = 0;
for my $source (sort @sources) {
  open my $input, '<', $source or die "error: cannot read $source: $!\n";
  my @lines = <$input>;
  close $input;
  my $relative = $source;
  $relative =~ s/^\Q$book_root\E\///;
  my $content = join('', @lines);
  ++$placeholders
    while $content =~ /^:::\s+\{\.alkahest-book-notes-placeholder\}\s*$/mg;
  die "error: $relative uses an inline note; use a registered named note\n"
    if $content =~ /\^\[/;

  my $in_fence;
  for (my $index = 0; $index < @lines; ++$index) {
    my $line = $lines[$index];
    if (defined $in_fence) {
      $in_fence = undef if $line =~ /^\Q$in_fence\E\s*$/;
      next;
    }
    if ($line =~ /^(`{3,}|~{3,})/) {
      $in_fence = $1;
      next;
    }
    while ($line =~ /\[\^([a-z][a-z0-9-]*)\]/g) {
      ++$references{$1};
      ++$reference_sources{$1}{$relative};
    }
    next unless $line =~ /^\[\^([a-z][a-z0-9-]*)\]:\s*(.*)$/;
    my ($name, $definition) = ($1, $2);
    die "error: duplicate note definition: $name\n"
      if exists $definitions{$name};
    my $line_number = $index + 1;
    while ($index + 1 < @lines
        && ($lines[$index + 1] =~ /^(?: {4}|\t)/
          || $lines[$index + 1] =~ /^\s*$/)) {
      ++$index;
      $definition .= $lines[$index];
    }
    $definitions{$name} = {
      marker => $definition,
      source => $relative,
      location => "$relative:$line_number",
    };
  }
}

die "error: expected exactly one book-notes placeholder; found $placeholders\n"
  unless $placeholders == 1;
for my $name (sort keys %definitions) {
  die "error: unregistered note definition: $name\n"
    unless exists $entries{$name};
}
for my $name (sort keys %references) {
  die "error: note reference has no registered definition: $name\n"
    unless exists $definitions{$name} && exists $entries{$name};
}
my $total_references = 0;
for my $name (@order) {
  my $entry = $entries{$name};
  my $definition = $definitions{$name}
    or die "error: registered note $name has no definition\n";
  die "error: note $name definition is in $definition->{source}; expected $entry->{source}\n"
    unless $definition->{source} eq $entry->{source};
  die "error: $definition->{location}: note marker must be #note-$name .alkahest-note\n"
    unless $definition->{marker}
      =~ /\{#note-\Q$name\E\s+\.alkahest-note\}/;
  my $actual_references = ($references{$name} // 0) - 1;
  die "error: note $name has no manuscript references\n"
    if $actual_references < 1;
  die "error: note $name has $actual_references references; registry expects $entry->{references}\n"
    unless $actual_references == $entry->{references};
  die "error: note $name is referenced outside $entry->{source}\n"
    if grep { $_ ne $entry->{source} } keys %{ $reference_sources{$name} };
  die "error: note $name repeats without repeat=reuse\n"
    if $actual_references > 1 && $entry->{repeat} ne 'reuse';
  $total_references += $actual_references;
}

print "ok: semantic notes (" . scalar(@order)
  . " definitions; $total_references references; footnote/chapter-endnote/book-endnote/sidenote placements; one generated apparatus)\n";
