#!/usr/bin/env perl
# Refresh the identity lock while requiring migrations for removals or renames.
use strict;
use warnings;
use Cwd qw(abs_path);
use FindBin qw($Bin);
use JSON::PP;
use lib "$Bin/lib";
use Alkahest::Identities qw(
  add_companion_assets canonical_variant identity_key inventory_book load_identity_policy load_json_file
  validate_edition_manifests validate_language_variants validate_migrations
);

die "usage: $0\n" if @ARGV;
my $repo_root = abs_path("$Bin/..");
my $book_root = $ENV{ALKAHEST_IDENTITY_BOOK_ROOT} // "$repo_root/book";
$book_root = abs_path($book_root)
  or die "error: identity book root does not exist\n";
my $policy = load_identity_policy("$book_root/identities.json");
validate_migrations($policy);
my $canonical = canonical_variant($book_root, $policy);
my $records = inventory_book($book_root, $policy, $canonical);

add_companion_assets($book_root, $policy, $records);
validate_language_variants($book_root, $policy, $records);
validate_edition_manifests($book_root, $policy, $records);

my $lock_path = "$book_root/identity-lock.json";
my $old = -f $lock_path
  ? load_json_file($lock_path, 'identity lock')
  : { version => 1, book_id => $policy->{book_id}, identities => [] };
die "error: identity lock belongs to a different book_id\n"
  if ($old->{book_id} // '') ne $policy->{book_id};

my (%old_active, %old_retired);
for my $entry (@{ $old->{identities} // [] }) {
  my $key = identity_key($entry);
  die "error: duplicate existing identity-lock entry\n"
    if exists $old_active{$key} || exists $old_retired{$key};
  if (($entry->{status} // '') eq 'active') {
    $old_active{$key} = $entry;
  } elsif (($entry->{status} // '') eq 'retired') {
    $old_retired{$key} = $entry;
  } else {
    die "error: malformed existing identity-lock entry\n";
  }
}
my %migrations = map {
  my $migration = $_;
  ("$migration->{namespace}\0$migration->{from}" => $migration);
} @{ $policy->{migrations} };

my @identities;
for my $key (sort keys %old_retired) {
  die "error: retired identity '$old_retired{$key}{namespace}:$old_retired{$key}{id}' was reused\n"
    if exists $records->{$key};
  my $entry = $old_retired{$key};
  my $migration = $migrations{$key}
    or die "error: retired identity '$entry->{namespace}:$entry->{id}' has no migration record\n";
  die "error: migration for retired identity '$entry->{namespace}:$entry->{id}' changed after retirement\n"
    if ($entry->{reason} // '') ne $migration->{reason}
      || (defined $migration->{to}
        ? ($entry->{replaced_by} // '') ne $migration->{to}
        : defined $entry->{replaced_by});
  push @identities, $entry;
}
for my $key (sort keys %old_active) {
  next if exists $records->{$key};
  my $old_entry = $old_active{$key};
  my $migration = $migrations{$key}
    or die "error: identity '$old_entry->{namespace}:$old_entry->{id}' disappeared without a migration\n";
  if (defined $migration->{to}) {
    my $target = "$migration->{namespace}\0$migration->{to}";
    die "error: migration target '$migration->{namespace}:$migration->{to}' does not exist\n"
      if !exists $records->{$target};
  }
  my %retired = %$old_entry;
  $retired{status} = 'retired';
  $retired{reason} = $migration->{reason};
  if (defined $migration->{to}) {
    $retired{replaced_by} = $migration->{to};
  } else {
    delete $retired{replaced_by};
  }
  push @identities, \%retired;
}
for my $key (sort keys %$records) {
  die "error: retired identity '$records->{$key}{namespace}:$records->{$key}{id}' was reused\n"
    if exists $old_retired{$key};
  my %entry = %{ $records->{$key} };
  delete $entry{line};
  $entry{status} = 'active';
  push @identities, \%entry;
}
for my $key (sort keys %migrations) {
  my $migration = $migrations{$key};
  die "error: migration '$migration->{namespace}:$migration->{from}' does not name a retired or removed identity\n"
    if !exists $old_retired{$key}
      && !(exists $old_active{$key} && !exists $records->{$key});
}
@identities = sort {
  $a->{namespace} cmp $b->{namespace}
    || $a->{id} cmp $b->{id}
    || $a->{status} cmp $b->{status}
} @identities;

my $output = {
  version => 1,
  book_id => $policy->{book_id},
  identities => \@identities,
};
my $json = JSON::PP->new->canonical(1)->pretty(1)->encode($output);
open my $handle, '>:raw', $lock_path
  or die "error: cannot write identity lock $lock_path: $!\n";
print {$handle} $json;
close $handle;
print "updated $lock_path (" . scalar(@identities) . " retained active/retired identities)\n";
