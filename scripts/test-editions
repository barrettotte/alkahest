#!/usr/bin/env perl
# Exercise valid, invalid, and staged whole-book edition contracts.
use strict;
use warnings;
use Cwd qw(abs_path);
use File::Temp qw(tempfile);
use FindBin qw($Bin);
use JSON::PP qw(decode_json encode_json);
use lib "$Bin/lib";
use Alkahest::Editions qw(load_editions);

my $registry_path = "$Bin/../book/editions.json";
open my $registry_handle, '<:raw', $registry_path
  or die "error: cannot read $registry_path: $!\n";
local $/;
my $registry_json = <$registry_handle>;
close $registry_handle;

sub registry_copy { return decode_json($registry_json); }
sub write_registry {
  my ($registry) = @_;
  my ($handle, $path) = tempfile('alkahest-editions-XXXXXX',
    TMPDIR => 1, SUFFIX => '.json', UNLINK => 1);
  print {$handle} encode_json($registry);
  close $handle;
  return $path;
}
sub expect_failure {
  my ($name, $expected, $mutate) = @_;
  my $registry = registry_copy();
  $mutate->($registry);
  my $error = '';
  eval { load_editions(write_registry($registry)); 1 } or $error = $@;
  die "error: edition fixture $name unexpectedly passed\n" if !$error;
  die "error: edition fixture $name missed diagnostic '$expected': $error"
    if index($error, $expected) < 0;
}

load_editions(write_registry(registry_copy()));
expect_failure('missing-edition', 'editions must be exactly', sub {
  delete $_[0]{editions}{abridged};
});
expect_failure('drifted-format', "edition 'print' has invalid formats", sub {
  $_[0]{editions}{print}{formats} = ['latex'];
});
expect_failure('unknown-source', "references unknown source 'missing'", sub {
  $_[0]{structures}{preview}{chapters}[1]{sources}[0] = 'missing';
});
expect_failure('duplicate-source', "repeats source 'reference'", sub {
  push @{ $_[0]{structures}{full}{chapters}[2]{sources} }, 'reference';
});
expect_failure('private-leak', "public edition 'abridged' includes private source", sub {
  $_[0]{sources}{reference}{availability} = 'private';
});
expect_failure('online-in-full', "structure 'full' does not select exactly", sub {
  $_[0]{sources}{'online-lab-notes'}{formats} = [qw(html epub typst latex)];
  push @{ $_[0]{structures}{full}{appendices}[1]{sources} }, 'online-lab-notes';
});
expect_failure('supplemental-in-web', "structure 'web' does not select exactly", sub {
  $_[0]{structures}{web}{appendices}[2]{sources}[0] = 'supplemental-workbook';
});
expect_failure('long-preview', 'preview structure must contain one or two', sub {
  push @{ $_[0]{structures}{preview}{chapters}[1]{sources} }, 'math';
});
expect_failure('complete-abridged', "structure 'abridged' must be a nonempty proper subset", sub {
  $_[0]{structures}{abridged} = decode_json(encode_json($_[0]{structures}{full}));
});

my $repo_root = abs_path("$Bin/..");
for my $edition (qw(public private preview abridged)) {
  system("$Bin/stage-edition", $edition) == 0
    or die "error: could not stage $edition fixture\n";
}
my $stage_parent = "$repo_root/book/_build/staging/editions";
die "error: public stage exposes private source directory\n"
  if -e "$stage_parent/public/private" || -l "$stage_parent/public/private";
die "error: private stage omits selected private source\n"
  if !-f "$stage_parent/private/private/working-notes.qmd";
die "error: preview stage contains omitted main chapter\n"
  if -e "$stage_parent/preview/math.qmd" || -l "$stage_parent/preview/math.qmd";
die "error: abridged stage contains omitted main chapter\n"
  if -e "$stage_parent/abridged/layout-stress.qmd"
    || -l "$stage_parent/abridged/layout-stress.qmd";

print "ok: edition fixtures (valid registry; 9 invalid contracts rejected; staged public/private and reduced-book isolation)\n";
