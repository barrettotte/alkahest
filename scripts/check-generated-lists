#!/usr/bin/env perl
# Validate generated-list configuration, object coverage, terminology, and placement.
use strict;
use warnings;
use Cwd qw(abs_path);
use File::Find qw(find);
use FindBin qw($Bin);

my $repo_root = abs_path("$Bin/..");
my $book_root = $ENV{ALKAHEST_GENERATED_LISTS_BOOK_ROOT} // "$repo_root/book";
$book_root = abs_path($book_root)
  or die "error: generated-list book root does not exist\n";
my $registry_path = "$book_root/generated-lists.yml";

sub scalar_value {
  my ($value, $location) = @_;
  $value =~ s/^\s+|\s+$//g;
  if ($value =~ /^'(.*)'$/) {
    $value = $1;
    $value =~ s/''/'/g;
  }
  elsif ($value =~ /^"(.*)"$/) {
    $value = $1;
    $value =~ s/\\"/"/g;
    $value =~ s/\\\\/\\/g;
  }
  die "error: $location: empty scalar value\n" unless $value =~ /\S/;
  return $value;
}

open my $registry, '<:encoding(UTF-8)', $registry_path
  or die "error: cannot read generated-list registry $registry_path: $!\n";
my @lines = <$registry>;
close $registry;

my ($version, $language, $section, $current_list, $current_term);
my (@order, @objects, %lists, %terms, %sections);
for (my $index = 0; $index < @lines; ++$index) {
  my $line_number = $index + 1;
  my $line = $lines[$index];
  chomp $line;
  next if $line =~ /^\s*(?:#.*)?$/;
  if ($line =~ /^version: ([0-9]+)$/) {
    die "error: $registry_path:$line_number: duplicate version\n"
      if defined $version;
    $version = $1;
    next;
  }
  if ($line =~ /^lang: (\S+)$/) {
    die "error: $registry_path:$line_number: duplicate language\n"
      if defined $language;
    $language = $1;
    next;
  }
  if ($line =~ /^(order|lists|objects|terms):$/) {
    $section = $1;
    die "error: $registry_path:$line_number: duplicate $section section\n"
      if $sections{$section}++;
    $current_list = undef;
    $current_term = undef;
    next;
  }
  die "error: $registry_path:$line_number: field appears before a section\n"
    unless defined $section;

  if ($section eq 'order' && $line =~ /^  - ([a-z][a-z0-9-]*)$/) {
    push @order, $1;
    next;
  }
  if ($section eq 'lists' && $line =~ /^  ([a-z][a-z0-9-]*):$/) {
    $current_list = $1;
    die "error: $registry_path:$line_number: duplicate list $current_list\n"
      if exists $lists{$current_list};
    $lists{$current_list} = { line => $line_number };
    next;
  }
  if ($section eq 'lists'
      && $line =~ /^    (title|source|prefix|enabled): (\S.*)$/) {
    my ($field, $raw) = ($1, $2);
    die "error: $registry_path:$line_number: list field before list name\n"
      unless defined $current_list;
    die "error: $registry_path:$line_number: duplicate $field for $current_list\n"
      if exists $lists{$current_list}{$field};
    $lists{$current_list}{$field} = scalar_value(
      $raw, "$registry_path:$line_number"
    );
    next;
  }
  if ($section eq 'objects'
      && $line =~ /^  - id: ([a-z][a-z0-9-]*)$/) {
    push @objects, { id => $1, line => $line_number };
    next;
  }
  if ($section eq 'objects' && $line =~ /^    title: (\S.*)$/) {
    die "error: $registry_path:$line_number: object title before object ID\n"
      unless @objects;
    die "error: $registry_path:$line_number: duplicate object title\n"
      if exists $objects[-1]{title};
    $objects[-1]{title} = scalar_value($1, "$registry_path:$line_number");
    next;
  }
  if ($section eq 'terms' && $line =~ /^  ([a-z][a-z0-9-]*):$/) {
    $current_term = $1;
    die "error: $registry_path:$line_number: duplicate term $current_term\n"
      if exists $terms{$current_term};
    $terms{$current_term} = { line => $line_number };
    next;
  }
  if ($section eq 'terms'
      && $line =~ /^    (list|display|meaning|sort|target): (\S.*)$/) {
    my ($field, $raw) = ($1, $2);
    die "error: $registry_path:$line_number: term field before term ID\n"
      unless defined $current_term;
    die "error: $registry_path:$line_number: duplicate $field for $current_term\n"
      if exists $terms{$current_term}{$field};
    $terms{$current_term}{$field} = scalar_value(
      $raw, "$registry_path:$line_number"
    );
    next;
  }
  die "error: $registry_path:$line_number: unsupported generated-list syntax: $line\n";
}

die "error: generated-list registry version must be 1\n"
  unless defined $version && $version == 1;
die "error: generated-list registry language must be a BCP 47 tag\n"
  unless ($language // '') =~ /^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$/;
for my $required (qw(order lists objects terms)) {
  die "error: generated-list registry has no $required section\n"
    unless $sections{$required};
}
die "error: generated-list registry has no configured lists\n" unless keys %lists;

my (%ordered, %prefix_owner, %source_count);
for my $name (@order) {
  die "error: duplicate list in order: $name\n" if $ordered{$name}++;
  die "error: unknown list in order: $name\n" unless exists $lists{$name};
}
for my $name (sort keys %lists) {
  my $list = $lists{$name};
  die "error: configured list $name is missing from order\n" unless $ordered{$name};
  die "error: configured list $name has no title\n"
    unless ($list->{title} // '') =~ /\S/;
  die "error: configured list $name has unsupported source\n"
    unless ($list->{source} // '') =~ /^(?:crossref|glossary-acronyms|terms)$/;
  $list->{enabled} //= 'true';
  die "error: configured list $name enabled must be true or false\n"
    unless $list->{enabled} eq 'true' || $list->{enabled} eq 'false';
  ++$source_count{$list->{source}};
  if ($list->{source} eq 'crossref') {
    die "error: cross-reference list $name has invalid prefix\n"
      unless ($list->{prefix} // '') =~ /^[a-z][a-z0-9]*$/;
    die "error: duplicate cross-reference prefix $list->{prefix}\n"
      if exists $prefix_owner{$list->{prefix}};
    $prefix_owner{$list->{prefix}} = $name;
  }
  elsif (exists $list->{prefix}) {
    die "error: non-cross-reference list $name cannot declare a prefix\n";
  }
}
die "error: generated-list registry permits at most one glossary-acronyms list\n"
  if ($source_count{'glossary-acronyms'} // 0) > 1;

my @sources;
find(
  {
    wanted => sub {
      return unless -f $_ && /\.qmd\z/;
      return if $File::Find::name =~ m{/(?:\.quarto|_build)/};
      push @sources, $File::Find::name;
    },
    no_chdir => 1,
  },
  $book_root,
);

my (%definitions, %definition_location);
my $placeholders = 0;
for my $source (sort @sources) {
  open my $input, '<:encoding(UTF-8)', $source
    or die "error: cannot read $source: $!\n";
  my ($line_number, $fence);
  while (my $line = <$input>) {
    ++$line_number;
    if (defined $fence) {
      if ($line =~ /^\Q$fence\E\s*$/) {
        $fence = undef;
        next;
      }
      if ($line =~ /^\s*(?:#|\/\/|%%)\|\s*label:\s*([a-z][a-z0-9]*-[a-z0-9-]+)\s*$/) {
        my $id = $1;
        my ($prefix) = $id =~ /^([a-z][a-z0-9]*)-/;
        if (exists $prefix_owner{$prefix}) {
          die "error: duplicate generated-list object definition $id\n"
            if $definitions{$id}++;
          $definition_location{$id} = "$source:$line_number";
        }
      }
      next;
    }
    ++$placeholders while $line =~ /\{\.alkahest-generated-lists-placeholder\}/g;
    die "error: $source:$line_number: use generated lists rather than a backend-specific list command\n"
      if $line =~ /\\(?:listoffigures|listoftables|listoflistings)\b/;
    while ($line =~ /#([a-z][a-z0-9]*-[a-z0-9-]+)/g) {
      my $id = $1;
      my ($prefix) = $id =~ /^([a-z][a-z0-9]*)-/;
      next unless exists $prefix_owner{$prefix};
      die "error: duplicate generated-list object definition $id\n"
        if $definitions{$id}++;
      $definition_location{$id} = "$source:$line_number";
    }
    $fence = $1 if $line =~ /^(`{3,}|~{3,})/;
  }
  close $input;
}

die "error: expected exactly one generated-lists placeholder; found $placeholders\n"
  unless $placeholders == 1;

my (%registered_objects, %list_entry_count);
for my $object (@objects) {
  my $id = $object->{id};
  die "error: duplicate generated-list object $id\n"
    if $registered_objects{$id}++;
  die "error: generated-list object $id has no title\n"
    unless ($object->{title} // '') =~ /\S/;
  my ($prefix) = $id =~ /^([a-z][a-z0-9]*)-/;
  my $owner = $prefix_owner{$prefix}
    or die "error: no configured cross-reference list owns $id\n";
  die "error: generated-list object target does not exist: $id\n"
    unless exists $definitions{$id};
  ++$list_entry_count{$owner};
}
for my $id (sort keys %definitions) {
  die "error: $definition_location{$id}: cross-reference object $id is missing from generated-lists.yml\n"
    unless $registered_objects{$id};
}

my %display_seen;
for my $name (sort keys %terms) {
  my $term = $terms{$name};
  for my $field (qw(list display meaning sort target)) {
    die "error: generated-list term $name has no $field\n"
      unless ($term->{$field} // '') =~ /\S/;
  }
  die "error: generated-list term $name display is a TeX fragment without dollar delimiters\n"
    if $term->{display} =~ /\$/;
  my $owner = $lists{$term->{list}};
  die "error: generated-list term $name targets an unknown terms list\n"
    unless defined $owner && $owner->{source} eq 'terms';
  die "error: duplicate generated-list term display $term->{display}\n"
    if $display_seen{$term->{display}}++;
  die "error: generated-list term $name targets unknown object $term->{target}\n"
    unless exists $definitions{$term->{target}};
  ++$list_entry_count{$term->{list}};
}

open my $glossary, '<:encoding(UTF-8)', "$book_root/glossary.yml"
  or die "error: cannot read glossary for acronym list: $!\n";
my $acronyms = 0;
while (my $line = <$glossary>) {
  ++$acronyms if $line =~ /^    acronym: \S/;
}
close $glossary;
for my $name (keys %lists) {
  if ($lists{$name}{source} eq 'glossary-acronyms') {
    $list_entry_count{$name} = $acronyms;
  }
}

my @empty_enabled = sort grep {
  $lists{$_}{enabled} eq 'true' && !($list_entry_count{$_} // 0)
} keys %lists;
print "ok: generated lists (" . scalar(keys %lists)
  . " configured; " . (scalar(keys %lists) - scalar(@empty_enabled))
  . " nonempty; " . scalar(@objects) . " cross-reference objects; "
  . "$acronyms acronyms; " . scalar(keys %terms) . " terms; empty enabled: "
  . (@empty_enabled ? join(', ', @empty_enabled) : 'none') . ")\n";
