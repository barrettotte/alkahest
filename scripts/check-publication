#!/usr/bin/env bash
# Validate rendered HTML links and EPUB conformance offline.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/toolchain.sh
source "${script_dir}/lib/toolchain.sh"
repo_root="$(alkahest_repo_root)"
invoking_uid="$(id -u)"
invoking_gid="$(id -g)"

if [[ "${invoking_uid}" -eq 0 ]]; then
  echo "error: publication checks must be run as a non-root host user" >&2
  exit 1
fi

if ! command -v podman >/dev/null 2>&1; then
  echo "error: Podman is required but was not found" >&2
  exit 1
fi

if ! podman image exists "${ALKAHEST_TOOLCHAIN_IMAGE}"; then
  echo "error: publishing image is not available locally" >&2
  echo "run ./scripts/bootstrap once while connected to the network" >&2
  exit 1
fi

# Mount outputs read-only and disable networking: link, locale, and EPUB
# conformance checks must not mutate artifacts or depend on external services.
exec podman run --rm \
  --pull=never \
  --network=none \
  --userns=keep-id \
  --user "${invoking_uid}:${invoking_gid}" \
  --security-opt label=disable \
  --tmpfs /tmp:rw,size=512m,mode=1777 \
  --env HOME=/tmp \
  --volume "${repo_root}:/workspace:ro" \
  --workdir /workspace \
  --entrypoint bash \
  "${ALKAHEST_TOOLCHAIN_IMAGE}" \
  -ec '
    trap "echo error: publication assertion failed near line \${LINENO} >&2" ERR

    require_literal() {
      needle="$1"
      file="$2"
      label="$3"
      if ! grep -Fq "${needle}" "${file}"; then
        echo "error: ${label} is missing required text: ${needle}" >&2
        exit 1
      fi
    }

    require_pattern() {
      pattern="$1"
      file="$2"
      label="$3"
      if ! grep -Eq "${pattern}" "${file}"; then
        echo "error: ${label} is missing required pattern: ${pattern}" >&2
        exit 1
      fi
    }

    # The small local checker handles site-relative files/fragments; EPUBCheck
    # supplies the full W3C EPUB ruleset from the locked image.
    python3 scripts/check-html-links.py book/_build/html
    python3 scripts/check-html-links.py book/_build/locale/fr/html
    for edition in abridged preview public private supplemental; do
      python3 scripts/check-html-links.py "book/_build/smoke/editions/${edition}/html"
    done
    scripts/check-rendered-notes
    scripts/check-rendered-identities
    scripts/check-rendered-index
    scripts/check-rendered-lists
    java -jar "${EPUBCHECK_JAR}" book/_build/epub/Alkahest-Reference-Book.epub

    # The reflowable artifacts must be self-contained and carry the same theme
    # roles and selected font faces; a successful render alone does not prove
    # that CSS resources were copied or embedded.
    html_theme="book/_build/html/theme/alkahest-fonts.css"
    epub_listing="$(mktemp)"
    epub_css="$(mktemp)"
    test -f "${html_theme}"
    unzip -Z1 book/_build/epub/Alkahest-Reference-Book.epub >"${epub_listing}"
    unzip -p book/_build/epub/Alkahest-Reference-Book.epub \
      EPUB/styles/stylesheet1.css >"${epub_css}"
    grep -R -Fq -- "--alkahest-primary" book/_build/html/site_libs/bootstrap
    grep -Fq "Embedded font notices" "${epub_css}"
    grep -Fq "color: #334155" "${epub_css}"
    for font_file in \
      LibertinusSerif-Regular.woff2 \
      LibertinusSerif-Italic.woff2 \
      LibertinusSerif-Bold.woff2 \
      LibertinusSerif-BoldItalic.woff2 \
      LibertinusSerifDisplay-Regular.woff2 \
      LibertinusSans-Regular.woff2 \
      LibertinusSans-Italic.woff2 \
      LibertinusSans-Bold.woff2 \
      SourceCodePro-Regular.otf.woff2 \
      SourceCodePro-It.otf.woff2 \
      SourceCodePro-Bold.otf.woff2 \
      SourceCodePro-BoldIt.otf.woff2
    do
      test -f "book/_build/html/theme/fonts/${font_file}"
      grep -Fq "fonts/${font_file}" "${html_theme}"
      grep -Fxq "EPUB/fonts/${font_file}" "${epub_listing}"
      grep -Fq "../fonts/${font_file}" "${epub_css}"
    done
    for license_file in Libertinus-OFL.txt Source-Code-Pro-OFL.md; do
      test -f "book/_build/html/theme/fonts/licenses/${license_file}"
    done

    # Conformance alone cannot detect a valid file that silently dropped one of
    # the shared front-matter or appendix components.
    html_text="$(mktemp)"
    epub_text="$(mktemp)"
    epub_language="$(mktemp)"
    epub_nav="$(mktemp)"
    epub_svg="$(mktemp)"
    abridged_text="$(mktemp)"
    preview_text="$(mktemp)"
    public_text="$(mktemp)"
    private_text="$(mktemp)"
    supplemental_text="$(mktemp)"
    find book/_build/html -type f -name "*.html" -exec cat {} + \
      | python3 scripts/text-normalize.py html >"${html_text}"
    unzip -p book/_build/epub/Alkahest-Reference-Book.epub \
      EPUB/nav.xhtml "EPUB/text/*.xhtml" \
      | python3 scripts/text-normalize.py html >"${epub_text}"
    unzip -p book/_build/epub/Alkahest-Reference-Book.epub \
      "EPUB/text/*.xhtml" >"${epub_language}"
    unzip -p book/_build/epub/Alkahest-Reference-Book.epub \
      EPUB/nav.xhtml >"${epub_nav}"
    unzip -p book/_build/epub/Alkahest-Reference-Book.epub \
      "EPUB/media/*.svg" >"${epub_svg}"
    find book/_build/smoke/editions/abridged/html -type f -name "*.html" \
      -exec cat {} + \
      | python3 scripts/text-normalize.py html \
      >"${abridged_text}"
    find book/_build/smoke/editions/preview/html -type f -name "*.html" \
      -exec cat {} + \
      | python3 scripts/text-normalize.py html \
      >"${preview_text}"
    find book/_build/smoke/editions/public/html -type f -name "*.html" \
      -exec cat {} + \
      | python3 scripts/text-normalize.py html \
      >"${public_text}"
    find book/_build/smoke/editions/private/html -type f -name "*.html" \
      -exec cat {} + \
      | python3 scripts/text-normalize.py html \
      >"${private_text}"
    find book/_build/smoke/editions/supplemental/html -type f -name "*.html" \
      -exec cat {} + \
      | python3 scripts/text-normalize.py html \
      >"${supplemental_text}"
    for marker in \
      "Publication data" \
      "For the readers who build things to understand them." \
      "Appendix A" \
      "Appendix B" \
      "Appendix C" \
      "Language and writing-system specimen" \
      "A deliberately long chapter title for testing wrapping" \
      "Page continuity after a pagination stress chapter" \
      "Layout acceptance record" \
      "Boundary Alpha begins" \
      "Boundary Lima ends" \
      "Contents" \
      "Section 1.1" \
      "Section 1.1.1" \
      "Figure 1.1" \
      "Table 1.1" \
      "Equation 1.1" \
      "Listing 1.1" \
      "Code blocks and executable-example presentation" \
      "counter.py" \
      "status.py" \
      "Clamp untrusted input before applying the thresholds." \
      "ALKAHEST_LONG_LINE_BEGIN" \
      "LONG_LINE_END" \
      "counter.patch" \
      "python3 counter.py" \
      "checksum.py" \
      "standard output" \
      "Mathematical notation and reasoning" \
      "Aligned equations" \
      "Cases and custom operators" \
      "Matrices and vectors" \
      "Theorem 6.1" \
      "Saturation bounds" \
      "Proof" \
      "Figures and visual evidence" \
      "Captions, alternatives, and provenance" \
      "Subfigures and panel references" \
      "Full-width and output-specific art" \
      "Figure 7.1" \
      "Figure 7.2" \
      "Figure 7.2 (a)" \
      "Figure 7.2 (b)" \
      "Figure 7.3" \
      "Source: original Alkahest fixture" \
      "Tables and instructional blocks" \
      "Measurement and acceptance plan" \
      "Bench-test sequence" \
      "Close the test session." \
      "Margin note: measure twice" \
      "Disconnect power before changing leads" \
      "Optional extension: characterize drift" \
      "Exercise 8.1" \
      "Solution 8.1" \
      "Project: build a threshold indicator" \
      "Lab: verify the threshold indicator" \
      "Learning components" \
      "Learning objectives" \
      "Prerequisites" \
      "Expected time:" \
      "Difficulty:" \
      "Review question: threshold evidence" \
      "Operating-interval exercise" \
      "Companion materials" \
      "Half-adder Verilog source" \
      "Half-adder truth-table dataset" \
      "Half-adder logic schematic" \
      "Half-adder bill of materials" \
      "Half-adder project pack manifest" \
      "Release package: companion/half-adder.v" \
      "Controlled content reuse" \
      "Safety notice — disconnect before changing connections." \
      "Observed value" \
      "Rights review notice." \
      "Worked example — tolerance interval." \
      "Project prerequisites." \
      "Dependency boundary" \
      "Semantic icons" \
      "Initial semantic icon registry" \
      "Equipment required." \
      "stored energy is present." \
      "Optional material." \
      "Stop if the hazard remains." \
      "Accessibility and narrow reflow" \
      "Icon meaning remains in visible text" \
      "Glossary authoring contract" \
      "central processing unit (CPU)" \
      "central processing units" \
      "CPUs" \
      "instruction set architecture (ISA)" \
      "matrices" \
      "quantum bits (qubits)" \
      "A useful footnote should not depend on the geometry of a printed page." \
      "Semantic notes remain in manuscript source order even when an edition moves their presentation."
    do
      if ! grep -Fq "${marker}" "${html_text}"; then
        echo "error: HTML is missing required marker: ${marker}" >&2
        exit 1
      fi
      if ! grep -Fq "${marker}" "${epub_text}"; then
        echo "error: EPUB is missing required marker: ${marker}" >&2
        exit 1
      fi
    done

    # The primary reflowable editions use the native-footnote fallback. Stable
    # semantic identity survives presentation, and reuse yields one navigable
    # occurrence per call without changing the registered content.
    html_notes_reference="book/_build/html/reference.html"
    html_notes_components="book/_build/html/components.html"
    for note_structure in \
      "data-note-id=\"page-geometry\" data-note-occurrence=\"1\"" \
      "data-note-id=\"page-geometry\" data-note-occurrence=\"2\""
    do
      require_literal "${note_structure}" "${html_notes_reference}" \
        "HTML semantic footnote"
      require_literal "${note_structure}" "${epub_language}" \
        "EPUB semantic footnote"
    done
    require_literal \
      "data-note-id=\"source-order\" data-note-occurrence=\"1\"" \
      "${html_notes_components}" "HTML cross-chapter semantic footnote"
    require_literal \
      "data-note-id=\"source-order\" data-note-occurrence=\"1\"" \
      "${epub_language}" "EPUB cross-chapter semantic footnote"
    require_literal \
      "href=\"#fn1\" class=\"footnote-ref\" id=\"fnref1\" role=\"doc-noteref\"" \
      "${html_notes_reference}" "HTML semantic footnote reference"
    require_literal \
      "href=\"#fnref1\" class=\"footnote-back\" role=\"doc-backlink\"" \
      "${html_notes_reference}" "HTML semantic footnote backlink"
    require_literal \
      "class=\"footnote-ref\" id=\"fnref1\" epub:type=\"noteref\" role=\"doc-noteref\"" \
      "${epub_language}" "EPUB semantic footnote reference"
    require_literal \
      "<aside epub:type=\"footnote\" role=\"doc-footnote\" id=\"fn1\">" \
      "${epub_language}" "EPUB semantic footnote target"
    for reflowable_text in "${html_text}" "${epub_text}"; do
      if [ "$(grep -Fo "A useful footnote should not depend on the geometry of a printed page." "${reflowable_text}" | wc -l)" -ne 2 ]; then
        echo "error: a primary reflowable edition does not contain two native repeat occurrences" >&2
        exit 1
      fi
      if [ "$(grep -Fo "Semantic notes remain in manuscript source order even when an edition moves their presentation." "${reflowable_text}" | wc -l)" -ne 1 ]; then
        echo "error: a primary reflowable edition does not contain one single-use note" >&2
        exit 1
      fi
    done

    # Appendix-local families share the appendix letter while advancing their
    # own counters. Stable IDs prove these are generated objects rather than
    # number-shaped prose, and the navigation checks bind A.2 to the contents.
    html_appendix="book/_build/html/appendices/page-system-checklist.html"
    for appendix_structure in \
      "id=\"sec-appendix-numbering\"" \
      "id=\"fig-appendix-signal\"" \
      "id=\"tbl-appendix-prefixes\"" \
      "id=\"eq-appendix-scale\"" \
      "id=\"lst-appendix-check\"" \
      "id=\"thm-appendix-ordering\"" \
      "id=\"nte-appendix-portability\"" \
      "id=\"wrn-appendix-manual-labels\"" \
      "id=\"exr-appendix-review\"" \
      "id=\"sol-appendix-review\""
    do
      require_literal "${appendix_structure}" "${html_appendix}" \
        "HTML appendix numbering specimen"
      require_literal "${appendix_structure}" "${epub_language}" \
        "EPUB appendix numbering specimen"
    done
    for appendix_marker in \
      "A.2 Numbered appendix elements" \
      "Figure A.1" \
      "Table A.1" \
      "Equation A.1" \
      "Listing A.1" \
      "Theorem A.1" \
      "Note A.1" \
      "Warning A.1" \
      "Exercise A.1" \
      "Solution A.1"
    do
      require_literal "${appendix_marker}" "${html_text}" \
        "HTML appendix numbering specimen"
      require_literal "${appendix_marker}" "${epub_text}" \
        "EPUB appendix numbering specimen"
    done
    require_literal \
      "#sec-appendix-numbering\"><span class=\"header-section-number\">A.2</span> Numbered appendix elements" \
      "${html_appendix}" "HTML appendix contents"
    require_literal \
      "#sec-appendix-numbering\"><span class=\"header-section-number\">A.2</span> Numbered appendix elements" \
      "${epub_nav}" "EPUB appendix contents"

    # Cross-references must cross the chapter/appendix boundary in both
    # directions. The appendix-only citation resolves into the single central
    # bibliography rather than generating an authored appendix reference list.
    html_reference="book/_build/html/reference.html"
    html_bibliography="book/_build/html/references.html"
    for chapter_to_appendix in \
      "href=\"appendices/page-system-checklist.html#sec-appendix-numbering\"" \
      "href=\"appendices/page-system-checklist.html#fig-appendix-signal\""
    do
      require_literal "${chapter_to_appendix}" "${html_reference}" \
        "HTML chapter-to-appendix reference"
    done
    for appendix_to_chapter in \
      "href=\"../reference.html#sec-heading-hierarchy\"" \
      "href=\"../reference.html#eq-ohms-law\""
    do
      require_literal "${appendix_to_chapter}" "${html_appendix}" \
        "HTML appendix-to-chapter reference"
    done
    for chapter_to_appendix in \
      "href=\"ch[0-9]+\\.xhtml#sec-appendix-numbering\"" \
      "href=\"ch[0-9]+\\.xhtml#fig-appendix-signal\""
    do
      require_pattern "${chapter_to_appendix}" "${epub_language}" \
        "EPUB chapter-to-appendix reference"
    done
    for appendix_to_chapter in \
      "href=\"ch[0-9]+\\.xhtml#sec-heading-hierarchy\"" \
      "href=\"ch[0-9]+\\.xhtml#eq-ohms-law\""
    do
      require_pattern "${appendix_to_chapter}" "${epub_language}" \
        "EPUB appendix-to-chapter reference"
    done
    require_literal "data-cites=\"knuth1984\"" "${html_appendix}" \
      "HTML appendix citation"
    require_literal "href=\"../references.html#ref-knuth1984\"" \
      "${html_appendix}" "HTML shared bibliography link"
    require_literal "id=\"ref-knuth1984\"" "${html_bibliography}" \
      "HTML shared bibliography entry"
    require_literal "data-cites=\"knuth1984\"" "${epub_language}" \
      "EPUB appendix citation"
    require_literal "id=\"ref-knuth1984\"" "${epub_language}" \
      "EPUB shared bibliography entry"
    require_literal "Knuth 1984" "${html_appendix}" "HTML appendix citation"
    require_literal "Knuth 1984" "${epub_language}" "EPUB appendix citation"
    for citation_marker in \
      "narrative form with Turing (1936)" \
      "page locator (Turing 1936, 230–31)" \
      "multiple sources (Turing 1936; Knuth 1984)" \
      "author suppression with Turing (1936)" \
      "repeated source (Turing 1936)"
    do
      require_literal "${citation_marker}" "${html_text}" \
        "HTML author-date citation specimen"
      require_literal "${citation_marker}" "${epub_text}" \
        "EPUB author-date citation specimen"
    done
    for shared_bibliography_marker in \
      "Knuth, Donald E. 1984" \
      "Literate Programming" \
      "10.1093/comjnl/27.2.97" \
      "Shannon, Claude E. 1948" \
      "Mathematical Theory of" \
      "10.1002/j.1538-7305.1948.tb01338.x"
    do
      require_literal "${shared_bibliography_marker}" "${html_bibliography}" \
        "HTML shared bibliography"
      require_literal "${shared_bibliography_marker}" "${epub_language}" \
        "EPUB shared bibliography"
    done
    if [ "$(grep -Fo "id=\"ref-knuth1984\"" "${html_bibliography}" | wc -l)" -ne 1 ]; then
      echo "error: HTML central bibliography does not contain exactly one Knuth entry" >&2
      exit 1
    fi
    if [ "$(grep -Fo "id=\"ref-knuth1984\"" "${epub_language}" | wc -l)" -ne 1 ]; then
      echo "error: EPUB does not contain exactly one Knuth bibliography entry" >&2
      exit 1
    fi

    # The composed numeric profile must retain the same citekeys, ordering,
    # locators, bibliography heading, and DOI data through both citeproc paths.
    numeric_html_reference="book/_build/smoke/citations/numeric/html/reference.html"
    numeric_html_bibliography="book/_build/smoke/citations/numeric/html/references.html"
    numeric_pdf="book/_build/smoke/citations/numeric/typst/Alkahest-Reference-Book.pdf"
    numeric_html_text="$(mktemp)"
    numeric_pdf_text="$(mktemp)"
    test -f "${numeric_html_reference}"
    test -f "${numeric_html_bibliography}"
    test -f "${numeric_pdf}"
    cat "${numeric_html_reference}" "${numeric_html_bibliography}" \
      | python3 scripts/text-normalize.py html \
      >"${numeric_html_text}"
    pdftotext -layout "${numeric_pdf}" - \
      | python3 scripts/text-normalize.py pdf \
      >"${numeric_pdf_text}"
    for numeric_marker in \
      "early citation [1]" \
      "narrative form with [1]" \
      "page locator [1, pp. 230–231]" \
      "multiple sources [1], [2]" \
      "author suppression with Turing [1]" \
      "repeated source [1]" \
      "References" \
      "[1] A. M. Turing" \
      "[2] D. E. Knuth" \
      "[3] C. E. Shannon" \
      "10.1112/plms/s2-42.1.230" \
      "10.1093/comjnl/27.2.97" \
      "10.1002/j.1538-7305.1948.tb01338.x"
    do
      require_literal "${numeric_marker}" "${numeric_html_text}" \
        "numeric HTML citation smoke edition"
      require_literal "${numeric_marker}" "${numeric_pdf_text}" \
        "numeric Typst citation smoke edition"
    done
    for numeric_key in turing1936 knuth1984 shannon1948; do
      require_literal "id=\"ref-${numeric_key}\"" "${numeric_html_bibliography}" \
        "numeric HTML bibliography entry"
    done
    # Quarto intentionally omits part dividers from EPUB. HTML retains its
    # explicitly selected online appendix, while EPUB and print select only the
    # core set from the checked registry.
    grep -Fq "Foundations" "${html_text}"
    for appendix_group in "Production reference" "Language reference"; do
      require_literal "${appendix_group}" book/_build/html/index.html \
        "HTML appendix group"
      if grep -Fq "${appendix_group}" "${epub_text}"; then
        echo "error: EPUB unexpectedly emitted appendix group divider: ${appendix_group}" >&2
        exit 1
      fi
    done
    require_literal "Online reference" book/_build/html/index.html \
      "HTML appendix group"
    require_literal "Appendix D" "${html_text}" "HTML online-only appendix"
    require_literal "Extended laboratory observations" "${html_text}" \
      "HTML online-only appendix"
    require_literal "id=\"sec-extended-lab-observations\"" \
      book/_build/html/appendices/online-lab-notes.html \
      "HTML online-only appendix"
    if grep -Fq "Extended laboratory observations" "${epub_text}"; then
      echo "error: EPUB includes the online-only appendix" >&2
      exit 1
    fi
    for primary_output in "${html_text}" "${epub_text}"; do
      if grep -Fq "Supplemental workbook" "${primary_output}"; then
        echo "error: a primary publication includes the supplemental appendix" >&2
        exit 1
      fi
    done

    # The reduced whole-book structures omit main-matter sources as well as
    # appendices. Abridged keeps a useful technical core; preview contains two
    # manuscript chapters and remains reference-safe.
    require_literal "Abridged foundations" \
      book/_build/smoke/editions/abridged/html/index.html "abridged part"
    for abridged_marker in \
      "Core feature specimen" \
      "Code blocks and executable-example presentation" \
      "Mathematical notation and reasoning" \
      "Figures and visual evidence" \
      "Tables and instructional blocks" \
      "Learning components" \
      "Companion materials" \
      "Controlled content reuse" \
      "Glossary authoring contract"
    do
      require_literal "${abridged_marker}" "${abridged_text}" "abridged edition"
    done
    for omitted_abridged_marker in \
      "A deliberately long chapter title for testing wrapping" \
      "Page continuity after a pagination stress chapter" \
      "Layout acceptance record" \
      "Semantic icons"
    do
      if grep -Fq "${omitted_abridged_marker}" "${abridged_text}"; then
        echo "error: abridged edition includes omitted chapter: ${omitted_abridged_marker}" >&2
        exit 1
      fi
    done

    # Preview omission is intentional and reference-safe: retained Appendix A
    # keeps its letter and local counters, while the conditional references to
    # omitted B and C disappear instead of becoming unresolved links.
    preview_root="book/_build/smoke/editions/preview/html"
    preview_reference="${preview_root}/reference.html"
    preview_appendix="${preview_root}/appendices/page-system-checklist.html"
    require_literal "Preview chapters" "${preview_root}/index.html" \
      "preview main-matter part"
    require_literal "Preview reference" "${preview_root}/index.html" \
      "preview appendix group"
    for preview_marker in \
      "Appendix A" \
      "A.2 Numbered appendix elements" \
      "Figure A.1" \
      "A chapter-to-appendix route reaches"
    do
      require_literal "${preview_marker}" "${preview_text}" "preview edition"
    done
    require_literal \
      "href=\"appendices/page-system-checklist.html#sec-appendix-numbering\"" \
      "${preview_reference}" "preview chapter-to-appendix reference"
    require_literal "href=\"../reference.html#sec-heading-hierarchy\"" \
      "${preview_appendix}" "preview appendix-to-chapter reference"
    for omitted_preview_marker in \
      "Code blocks and executable-example presentation" \
      "Mathematical notation and reasoning" \
      "Figures and visual evidence" \
      "Tables and instructional blocks" \
      "Learning components" \
      "Companion materials" \
      "Controlled content reuse" \
      "Semantic icons" \
      "Format behavior" \
      "Language and writing-system specimen" \
      "Extended laboratory observations" \
      "Supplemental workbook"
    do
      if grep -Fq "${omitted_preview_marker}" "${preview_text}"; then
        echo "error: preview edition includes omitted appendix: ${omitted_preview_marker}" >&2
        exit 1
      fi
    done
    if grep -Fq "sec-format-behavior" "${preview_reference}" \
      || grep -Fq "sec-language-and-script" "${preview_reference}"
    then
      echo "error: preview edition retains a reference to an omitted appendix" >&2
      exit 1
    fi

    # Public/full and private structures share core content, but only the
    # explicitly private render may contain the editorial canary source.
    private_canary="internal editorial canary and must never appear in a public artifact"
    private_answer_marker="Answer key: threshold evidence"
    require_literal "Core feature specimen" "${public_text}" "public edition"
    require_literal "Private working material" \
      book/_build/smoke/editions/private/html/index.html "private edition part"
    require_literal "${private_canary}" "${private_text}" "private edition"
    require_literal "${private_answer_marker}" "${private_text}" "private answer key"
    require_literal "id=\"ans-threshold-reasoning\"" \
      book/_build/smoke/editions/private/html/private/answer-key.html \
      "private answer-key identity"
    require_literal "data-for=\"rev-threshold-reasoning\"" \
      book/_build/smoke/editions/private/html/private/answer-key.html \
      "private answer-key relationship"
    for public_artifact in \
      "${html_text}" "${epub_text}" "${abridged_text}" "${preview_text}" \
      "${public_text}" "${supplemental_text}"
    do
      if grep -Fq "${private_canary}" "${public_artifact}"; then
        echo "error: private manuscript content leaked into a public artifact" >&2
        exit 1
      fi
      if grep -Fq "${private_answer_marker}" "${public_artifact}"; then
        echo "error: private answer-key content leaked into a public artifact" >&2
        exit 1
      fi
