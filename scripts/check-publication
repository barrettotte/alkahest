#!/usr/bin/env bash
# Validate rendered HTML links and EPUB conformance offline.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/toolchain.sh
source "${script_dir}/lib/toolchain.sh"
repo_root="$(alkahest_repo_root)"
invoking_uid="$(id -u)"
invoking_gid="$(id -g)"

if [[ "${invoking_uid}" -eq 0 ]]; then
  echo "error: publication checks must be run as a non-root host user" >&2
  exit 1
fi

if ! command -v podman >/dev/null 2>&1; then
  echo "error: Podman is required but was not found" >&2
  exit 1
fi

if ! podman image exists "${ALKAHEST_TOOLCHAIN_IMAGE}"; then
  echo "error: publishing image is not available locally" >&2
  echo "run ./scripts/bootstrap once while connected to the network" >&2
  exit 1
fi

# Mount outputs read-only and disable networking: link, locale, and EPUB
# conformance checks must not mutate artifacts or depend on external services.
exec podman run --rm \
  --pull=never \
  --network=none \
  --userns=keep-id \
  --user "${invoking_uid}:${invoking_gid}" \
  --security-opt label=disable \
  --tmpfs /tmp:rw,size=512m,mode=1777 \
  --env HOME=/tmp \
  --volume "${repo_root}:/workspace:ro" \
  --workdir /workspace \
  --entrypoint sh \
  "${ALKAHEST_TOOLCHAIN_IMAGE}" \
  -ec '
    require_literal() {
      needle="$1"
      file="$2"
      label="$3"
      if ! grep -Fq "${needle}" "${file}"; then
        echo "error: ${label} is missing required text: ${needle}" >&2
        exit 1
      fi
    }

    # The small local checker handles site-relative files/fragments; EPUBCheck
    # supplies the full W3C EPUB ruleset from the locked image.
    perl scripts/check-html-links book/_build/html
    perl scripts/check-html-links book/_build/locale/fr/html
    java -jar "${EPUBCHECK_JAR}" book/_build/epub/Alkahest-Reference-Book.epub

    # The reflowable artifacts must be self-contained and carry the same theme
    # roles and selected font faces; a successful render alone does not prove
    # that CSS resources were copied or embedded.
    html_theme="book/_build/html/theme/alkahest-fonts.css"
    epub_listing="$(mktemp)"
    epub_css="$(mktemp)"
    test -f "${html_theme}"
    unzip -Z1 book/_build/epub/Alkahest-Reference-Book.epub >"${epub_listing}"
    unzip -p book/_build/epub/Alkahest-Reference-Book.epub \
      EPUB/styles/stylesheet1.css >"${epub_css}"
    grep -R -Fq -- "--alkahest-primary" book/_build/html/site_libs/bootstrap
    grep -Fq "Embedded font notices" "${epub_css}"
    grep -Fq "color: #334155" "${epub_css}"
    for font_file in \
      LibertinusSerif-Regular.woff2 \
      LibertinusSerif-Italic.woff2 \
      LibertinusSerif-Bold.woff2 \
      LibertinusSerif-BoldItalic.woff2 \
      LibertinusSerifDisplay-Regular.woff2 \
      LibertinusSans-Regular.woff2 \
      LibertinusSans-Italic.woff2 \
      LibertinusSans-Bold.woff2 \
      SourceCodePro-Regular.otf.woff2 \
      SourceCodePro-It.otf.woff2 \
      SourceCodePro-Bold.otf.woff2 \
      SourceCodePro-BoldIt.otf.woff2
    do
      test -f "book/_build/html/theme/fonts/${font_file}"
      grep -Fq "fonts/${font_file}" "${html_theme}"
      grep -Fxq "EPUB/fonts/${font_file}" "${epub_listing}"
      grep -Fq "../fonts/${font_file}" "${epub_css}"
    done
    for license_file in Libertinus-OFL.txt Source-Code-Pro-OFL.md; do
      test -f "book/_build/html/theme/fonts/licenses/${license_file}"
    done

    # Conformance alone cannot detect a valid file that silently dropped one of
    # the shared front-matter or appendix components.
    html_text="$(mktemp)"
    epub_text="$(mktemp)"
    epub_language="$(mktemp)"
    epub_svg="$(mktemp)"
    find book/_build/html -type f -name "*.html" -exec cat {} + \
      | perl -CSD -0777 -pe "s/<[^>]+>/ /g; s/&nbsp;|&#160;|\x{A0}/ /g; s/\s+/ /g" >"${html_text}"
    unzip -p book/_build/epub/Alkahest-Reference-Book.epub \
      EPUB/nav.xhtml "EPUB/text/*.xhtml" \
      | perl -CSD -0777 -pe "s/<[^>]+>/ /g; s/&nbsp;|&#160;|\x{A0}/ /g; s/\s+/ /g" >"${epub_text}"
    unzip -p book/_build/epub/Alkahest-Reference-Book.epub \
      "EPUB/text/*.xhtml" >"${epub_language}"
    unzip -p book/_build/epub/Alkahest-Reference-Book.epub \
      "EPUB/media/*.svg" >"${epub_svg}"
    for marker in \
      "Publication data" \
      "For the readers who build things to understand them." \
      "Appendix A" \
      "Appendix B" \
      "Appendix C" \
      "Language and writing-system specimen" \
      "A deliberately long chapter title for testing wrapping" \
      "Page continuity after a pagination stress chapter" \
      "Layout acceptance record" \
      "Boundary Alpha begins" \
      "Boundary Lima ends" \
      "Contents" \
      "Section 1.1" \
      "Section 1.1.1" \
      "Figure 1.1" \
      "Table 1.1" \
      "Equation 1.1" \
      "Listing 1.1" \
      "Code blocks and executable-example presentation" \
      "counter.py" \
      "status.py" \
      "Clamp untrusted input before applying the thresholds." \
      "ALKAHEST_LONG_LINE_BEGIN" \
      "LONG_LINE_END" \
      "counter.patch" \
      "python3 counter.py" \
      "checksum.py" \
      "standard output" \
      "Mathematical notation and reasoning" \
      "Aligned equations" \
      "Cases and custom operators" \
      "Matrices and vectors" \
      "Theorem 6.1" \
      "Saturation bounds" \
      "Proof" \
      "Figures and visual evidence" \
      "Captions, alternatives, and provenance" \
      "Subfigures and panel references" \
      "Full-width and output-specific art" \
      "Figure 7.1" \
      "Figure 7.2" \
      "Figure 7.2 (a)" \
      "Figure 7.2 (b)" \
      "Figure 7.3" \
      "Source: original Alkahest fixture" \
      "Tables and instructional blocks" \
      "Measurement and acceptance plan" \
      "Bench-test sequence" \
      "Close the test session." \
      "Margin note: measure twice" \
      "Disconnect power before changing leads" \
      "Optional extension: characterize drift" \
      "Exercise 8.1" \
      "Solution 8.1" \
      "Project: build a threshold indicator" \
      "Lab: verify the threshold indicator" \
      "Semantic icons" \
      "Initial semantic icon registry" \
      "Equipment required." \
      "stored energy is present." \
      "Optional material." \
      "Stop if the hazard remains." \
      "Accessibility and narrow reflow" \
      "Icon meaning remains in visible text" \
      "Glossary authoring contract" \
      "central processing unit (CPU)" \
      "central processing units" \
      "CPUs" \
      "instruction set architecture (ISA)" \
      "matrices" \
      "quantum bits (qubits)"
    do
      if ! grep -Fq "${marker}" "${html_text}"; then
        echo "error: HTML is missing required marker: ${marker}" >&2
        exit 1
      fi
      if ! grep -Fq "${marker}" "${epub_text}"; then
        echo "error: EPUB is missing required marker: ${marker}" >&2
        exit 1
      fi
    done
    # Quarto intentionally omits part dividers from EPUB, but HTML must retain it.
    grep -Fq "Foundations" "${html_text}"
    for appendix_group in "Production reference" "Language reference"; do
      require_literal "${appendix_group}" book/_build/html/index.html \
        "HTML appendix group"
      if grep -Fq "${appendix_group}" "${epub_text}"; then
        echo "error: EPUB unexpectedly emitted appendix group divider: ${appendix_group}" >&2
        exit 1
      fi
    done
    for default_only_output in "${html_text}" "${epub_text}"; do
      if grep -Fq "Extended laboratory observations" "${default_only_output}"; then
        echo "error: default publication includes the online-only appendix" >&2
        exit 1
      fi
    done
    grep -Eq "widows:[[:space:]]*2" book/_build/html/site_libs/bootstrap/*.css
    grep -Eq "orphans:[[:space:]]*2" book/_build/html/site_libs/bootstrap/*.css
    grep -Eq "overflow-wrap:[[:space:]]*anywhere" book/_build/html/site_libs/bootstrap/*.css
    grep -Eq "overflow-x:[[:space:]]*auto" book/_build/html/site_libs/bootstrap/*.css
    grep -Eq "widows:[[:space:]]*2" "${epub_css}"
    grep -Eq "orphans:[[:space:]]*2" "${epub_css}"
    grep -Eq "overflow-wrap:[[:space:]]*anywhere" "${epub_css}"
    grep -Eq "white-space:[[:space:]]*pre-wrap" "${epub_css}"
    html_code="book/_build/html/code-blocks.html"
    for code_structure in \
      "class=\"code-with-filename\"" \
      "class=\"code-with-filename-file\"" \
      "number-lines" \
      "code-annotation-container-grid" \
      "code-copy-button" \
      "code-output"
    do
      require_literal "${code_structure}" "${html_code}" "HTML code specimen"
    done
    for code_structure in \
      "class=\"code-with-filename\"" \
      "class=\"code-with-filename-file\"" \
      "number-lines" \
      "data-code-annotation=\"1\"" \
      "code-output"
    do
      require_literal "${code_structure}" "${epub_language}" "EPUB code specimen"
    done

    # Web and EPUB mathematics stays semantic and offline: native MathML,
    # stable cross-reference targets, and native theorem/proof structures.
    html_math="book/_build/html/math.html"
    for math_structure in \
      "<math display=\"inline\"" \
      "<math display=\"block\"" \
      "id=\"eq-state-update\"" \
      "id=\"eq-saturation\"" \
      "id=\"eq-coordinate-rotation\"" \
      "id=\"thm-saturation-bounds\" class=\"theorem\"" \
      "class=\"theorem-title\"" \
      "class=\"proof\"" \
      "class=\"proof-title\""
    do
      require_literal "${math_structure}" "${html_math}" "HTML math specimen"
      require_literal "${math_structure}" "${epub_language}" "EPUB math specimen"
    done
    if grep -RiEq "<script[^>]+src=[^>]*mathjax" book/_build/html; then
      echo "error: HTML math unexpectedly depends on MathJax" >&2
      exit 1
    fi
    for math_description in \
      "Discrete state-space update and output equations" \
      "Piecewise saturation of x between lower and upper bounds" \
      "Two-dimensional coordinate rotation matrix"
    do
      require_literal "${math_description}" book/math.qmd "math source description"
    done

    # Figures retain IDs, panel relationships, explicit alternatives, source
    # credit, and exactly one medium-specific asset inside each publication.
    html_figures="book/_build/html/figures.html"
    for figure_structure in \
      "id=\"fig-signal-chain\"" \
      "id=\"fig-waveform-comparison\" class=\"quarto-layout-panel\"" \
      "id=\"fig-waveform-raw\"" \
      "id=\"fig-waveform-filtered\"" \
      "data-ref-parent=\"fig-waveform-comparison\"" \
      "id=\"fig-system-map\" class=\"figure-full-width" \
      "class=\"figure-source\""
    do
      require_literal "${figure_structure}" "${html_figures}" "HTML figure specimen"
      require_literal "${figure_structure}" "${epub_language}" "EPUB figure specimen"
    done
    for figure_alt in \
      "A three-stage signal chain runs from a sensor through signal conditioning to a decision stage." \
      "A jagged sampled waveform varies around a broad rise and fall" \
      "A smooth waveform rises to one broad peak and falls" \
      "Four modules form a closed loop: observe, model, decide, and act."
    do
      require_literal "${figure_alt}" "${html_figures}" "HTML figure alternative"
      require_literal "${figure_alt}" "${epub_language}" "EPUB figure alternative"
    done
    require_literal "figures/system-map-screen.svg" "${html_figures}" "HTML figure variant"
    require_literal "screen edition" "${epub_svg}" "EPUB figure variant"
    if grep -Fq "system-map-print.svg" "${html_figures}" \
      || grep -Fq "print edition" "${epub_svg}"
    then
      echo "error: a reflowable output contains the print-only figure variant" >&2
      exit 1
    fi
    if grep -Fq "1.1.1.1" "${html_text}" || grep -Fq "1.1.1.1" "${epub_text}"; then
      echo "error: a reflowable output incorrectly numbers the H4 detail heading" >&2
      exit 1
    fi

    # Tables and instructional blocks retain semantic HTML rather than relying
    # on visual styling. EPUBCheck separately catches duplicate or invalid IDs.
    html_components="book/_build/html/components.html"
    html_component_css=""
    for css_candidate in book/_build/html/site_libs/bootstrap/bootstrap-*.min.css; do
      html_component_css="${css_candidate}"
      break
    done
    test -n "${html_component_css}"
    for component_structure in \
      "id=\"tbl-measurement-plan\"" \
      "data-tbl-colwidths=\"[24,22,18,36]\"" \
      "id=\"test-sequence-table\"" \
      "id=\"nte-measure-twice\"" \
      "id=\"wrn-disconnect-power\"" \
      "id=\"exr-divider-budget\"" \
      "id=\"sol-divider-budget\"" \
      "id=\"project-threshold-indicator\"" \
      "id=\"lab-verify-threshold\""
    do
      require_literal "${component_structure}" "${html_components}" "HTML component specimen"
      require_literal "${component_structure}" "${epub_language}" "EPUB component specimen"
    done
    for component_class in \
      "class=\"margin-note icon-notice callout" \
      "class=\"icon-notice callout callout-style-simple callout-warning no-icon" \
      "class=\"optional-material-block icon-notice callout" \
      "class=\"project-block icon-notice callout" \
      "class=\"lab-block icon-notice callout"
    do
      require_literal "${component_class}" "${html_components}" "HTML component specimen"
    done
    for component_class in \
      "callout-note" \
      "callout-warning" \
      "class=\"optional-material-block icon-notice\"" \
      "class=\"project-block icon-notice\"" \
      "class=\"lab-block icon-notice\"" \
      "project-anchor" \
      "lab-anchor"
    do
      require_literal "${component_class}" "${epub_language}" "EPUB component specimen"
    done
    for notice_icon in \
      idea \
      warning \
      optional-material \
      equipment \
      experiment
    do
      require_literal "data-icon=\"${notice_icon}\"" "${html_components}" "HTML notice icon"
      require_literal "data-icon=\"${notice_icon}\"" "${epub_language}" "EPUB notice icon"
    done
    require_literal "no-icon callout-titled" "${html_components}" "HTML notice built-in icon suppression"
    require_literal "no-icon callout-titled" "${epub_language}" "EPUB notice built-in icon suppression"
    require_literal ".callout.icon-notice .callout-title-container .semantic-icon" \
      "${html_component_css}" "HTML notice icon sizing"
    require_literal "vertical-align:-0.12em" \
      "${html_component_css}" "HTML notice icon baseline"
    require_literal ".icon-notice .callout-title .semantic-icon" \
      "${epub_css}" "EPUB notice icon sizing"
    require_literal "vertical-align: -0.12em" "${epub_css}" "EPUB notice icon baseline"
    require_literal "margin-right: 0.28em" "${epub_css}" "EPUB notice icon spacing"
    require_literal "<table" "${html_components}" "HTML component specimen"
    require_literal "<th" "${html_components}" "HTML component specimen"
    require_literal "<table" "${epub_language}" "EPUB component specimen"
    require_literal "<th" "${epub_language}" "EPUB component specimen"
    for component_reference in \
      "Table&nbsp;<span>8.1</span>" \
      "Note&nbsp;<span>8.1</span>" \
      "Warning&nbsp;<span>8.1</span>"
    do
      require_literal "${component_reference}" "${html_components}" "HTML component reference"
    done

    # The shortcode registry emits the same canonical identity and accessible
    # image alternative in both reflowable formats. EPUB renames media files,
    # so embedded SVG titles prove that all six repository assets were packed.
    html_icons="book/_build/html/icons.html"
    for icon_name in \
      equipment \
      warning \
      danger \
      idea \
      experiment \
      optional-material
    do
      require_literal "data-icon=\"${icon_name}\"" "${html_icons}" "HTML icon specimen"
      require_literal "data-icon=\"${icon_name}\"" "${epub_language}" "EPUB icon specimen"
      require_literal "icons/${icon_name}.svg" "${html_icons}" "HTML icon asset"
    done
    for icon_label in \
      "Equipment required" \
      "Warning" \
      "Danger" \
      "Idea" \
      "Experiment" \
      "Optional material" \
      "Stop; danger remains"
    do
      require_literal "alt=\"${icon_label}\"" "${html_icons}" "HTML icon alternative"
      require_literal "alt=\"${icon_label}\"" "${epub_language}" "EPUB icon alternative"
    done
    for icon_title in \
      "Equipment symbol" \
      "Warning symbol" \
      "Danger symbol" \
      "Idea symbol" \
      "Experiment symbol" \
      "Optional material symbol"
    do
      require_literal "${icon_title}" "${epub_svg}" "EPUB icon asset"
    done
    require_literal "class=\"semantic-icon semantic-icon-danger\"" "${html_icons}" "HTML icon alias"
    require_literal "data-icon-label=\"Stop; danger remains\"" "${html_icons}" "HTML icon label override"
    scripts/check-rendered-icons "${html_icons}" "${html_components}" "${epub_language}"
    require_literal ".icon-accessibility-specimen{" \
      "${html_component_css}" "HTML narrow icon specimen"
    require_literal "@media(max-width: 480px)" \
      "${html_component_css}" "HTML narrow notice breakpoint"
    require_literal "overflow-wrap:anywhere" \
      "${html_component_css}" "HTML narrow icon wrapping"
    require_literal ".icon-accessibility-specimen" \
      "${epub_css}" "EPUB narrow icon specimen"
    require_literal "max-width: 18rem" "${epub_css}" "EPUB narrow icon measure"
    require_literal "overflow-wrap: anywhere" "${epub_css}" "EPUB narrow icon wrapping"
    require_literal "vertical-align: -0.14em" "${epub_css}" "EPUB icon baseline"

    # Glossary references retain canonical identity and requested display form;
    # reflowable outputs link to generated, stably anchored definitions.
    html_reference="book/_build/html/reference.html"
    html_glossary="book/_build/html/glossary.html"
    html_glossary_backmatter="book/_build/html/glossary-backmatter.html"
    locale_glossary_backmatter="book/_build/locale/fr/html/glossary-backmatter.html"
    require_literal "class=\"generated-glossary\"" \
      "${html_glossary_backmatter}" "HTML generated glossary"
    require_literal "data-glossary-count=\"4\"" \
      "${html_glossary_backmatter}" "HTML generated glossary count"
    require_literal "class=\"glossary-entry\"" \
      "${html_glossary_backmatter}" "HTML glossary semantics"
    require_literal "aria-labelledby=\"glossary-central-processing-unit\"" \
      "${html_glossary_backmatter}" "HTML glossary accessible name"
    require_literal "role=\"definition\"" \
      "${html_glossary_backmatter}" "HTML glossary definition role"
    require_literal "class=\"generated-glossary\"" \
      "${epub_language}" "EPUB generated glossary"
    require_literal "data-glossary-count=\"4\"" \
      "${epub_language}" "EPUB generated glossary count"
    require_literal "role=\"definition\"" \
      "${epub_language}" "EPUB glossary definition role"

    # The explicit first use lives in an earlier chapter than the remaining
    # CPU references. Sentence casing must transform Unicode-aware visible text
    # without changing identity, language, or the default-link contract.
    require_literal "glossary-backmatter.html#glossary-central-processing-unit" \
      "${html_reference}" "HTML cross-chapter glossary link"
    require_literal "data-glossary-case=\"sentence\"" \
      "${html_reference}" "HTML glossary sentence case"
    require_literal "data-glossary-link=\"true\"" \
      "${html_reference}" "HTML default glossary link"
    require_literal "lang=\"en-US\"" \
      "${html_reference}" "HTML glossary reference language"
    require_literal "Central processing unit (CPU)" \
      "${html_reference}" "HTML sentence-cased glossary text"
    require_literal "data-glossary-case=\"sentence\"" \
      "${epub_language}" "EPUB glossary sentence case"
    require_literal "Central processing unit (CPU)" \
      "${epub_language}" "EPUB sentence-cased glossary text"

    # Authors can suppress navigation for an output-safe semantic fallback.
    # The nested span at this stable specimen ID deliberately has no anchor.
    require_literal "<span id=\"glossary-unlinked-fallback\"><span class=\"glossary-term\"" \
      "${html_glossary}" "HTML unlinked glossary fallback"
    require_literal "data-glossary-link=\"false\"" \
      "${html_glossary}" "HTML unlinked glossary policy"
    require_literal ">matrix</span></span>" \
      "${html_glossary}" "HTML unlinked glossary text"
    require_literal "id=\"glossary-unlinked-fallback\"" \
      "${epub_language}" "EPUB unlinked glossary fallback"
    require_literal "data-glossary-link=\"false\"" \
      "${epub_language}" "EPUB unlinked glossary policy"
    require_literal ">matrix</span></span>" \
      "${epub_language}" "EPUB unlinked glossary text"
    previous_glossary_line=0
    for glossary_id in \
      central-processing-unit \
      instruction-set-architecture \
      matrix \
      quantum-bit
    do
      require_literal "data-glossary-id=\"${glossary_id}\"" \
        "${html_glossary}" "HTML glossary reference"
      require_literal "data-glossary-id=\"${glossary_id}\"" \
        "${epub_language}" "EPUB glossary reference"
      require_literal "id=\"glossary-${glossary_id}\"" \
        "${html_glossary_backmatter}" "HTML glossary anchor"
      require_literal "id=\"glossary-${glossary_id}\"" \
        "${epub_language}" "EPUB glossary anchor"
      require_literal "glossary-${glossary_id}\" class=\"glossary-link\" title=\"" \
        "${html_glossary}" "HTML glossary link and tooltip"
      require_literal "glossary-${glossary_id}\" class=\"glossary-link\" title=\"" \
        "${epub_language}" "EPUB glossary link and tooltip"
      glossary_line="$(grep -n -m1 "id=\"glossary-${glossary_id}\"" \
        "${html_glossary_backmatter}" | cut -d: -f1)"
      if [ "${glossary_line}" -le "${previous_glossary_line}" ]; then
        echo "error: HTML glossary entries are not in stable display-term order" >&2
        exit 1
      fi
      previous_glossary_line="${glossary_line}"
    done
    for glossary_form in \
      term \
      plural \
      acronym \
      acronym-plural \
      first \
      first-plural
    do
      require_literal "data-glossary-form=\"${glossary_form}\"" \
        "${html_glossary}" "HTML glossary form"
      require_literal "data-glossary-form=\"${glossary_form}\"" \
        "${epub_language}" "EPUB glossary form"
    done
    require_literal "<span class=\"glossary-term\"" \
      "${html_glossary}" "HTML portable glossary span"
    require_literal "<span class=\"glossary-term\"" \
      "${epub_language}" "EPUB portable glossary span"
    require_literal ".glossary-entry{" \
      "${html_component_css}" "HTML glossary entry theme"
    require_literal ".glossary-entry" \
      "${epub_css}" "EPUB glossary entry theme"
    for glossary_output in \
      "${html_glossary_backmatter}" \
      "${epub_language}" \
      "${locale_glossary_backmatter}"
    do
      require_literal "class=\"generated-glossary\"" \
        "${glossary_output}" "generated glossary language scope"
      require_literal "lang=\"en-US\"" \
        "${glossary_output}" "generated glossary language scope"
      require_literal "role=\"definition\"" \
        "${glossary_output}" "generated glossary definition semantics"
    done
    # Require both the primary locale and scoped language/direction semantics.
    # These attributes drive hyphenation, shaping, and assistive technology;
    # visible multilingual text alone is not sufficient evidence.
    html_language="book/_build/html/appendices/language-and-script.html"
    locale_index="book/_build/locale/fr/html/index.html"
    locale_reference="book/_build/locale/fr/html/reference.html"
    require_literal "lang=\"en-US\"" book/_build/html/index.html "HTML root"
    require_literal "lang=\"fr-FR\"" "${locale_index}" "French HTML root"
    for semantic_attribute in \
      "lang=\"en-US\"" \
      "lang=\"fr-FR\"" \
      "lang=\"de-DE\"" \
      "lang=\"el-GR\"" \
      "lang=\"ru-RU\"" \
      "lang=\"he-IL\" dir=\"rtl\""
    do
      require_literal "${semantic_attribute}" "${html_language}" "HTML language specimen"
      require_literal "${semantic_attribute}" "${epub_language}" "EPUB language specimen"
    done

    # The French smoke edition checks document-level locale changes and known
    # generated labels. Prose intentionally remains the same reference text.
    require_literal "Table des matières" "${locale_index}" "French HTML"
    require_literal "Tableau&nbsp;" "${locale_reference}" "French HTML"
    require_literal "Équation&nbsp;" "${locale_reference}" "French HTML"
    require_literal "Extrait&nbsp;" "${locale_reference}" "French HTML"
    require_literal "Annexe A" "${locale_reference}" "French HTML"

    # Preserve both documented nonbreaking forms. HTML serializes NBSP as an
    # entity; EPUB serializes it as Unicode, while both retain narrow NBSP.
    require_literal "25&nbsp;MHz" "${html_language}" "HTML language specimen"
    require_literal "Figure&nbsp;1" "${html_language}" "HTML language specimen"
    if ! perl -MEncode -0777 -e \
      '"'"'$_ = Encode::decode("UTF-8", <>);
       exit !(/Fran\x{00E7}ais\x{202F}:/)'"'"' "${html_language}"
    then
      echo "error: HTML did not preserve the narrow nonbreaking space" >&2
      exit 1
    fi
    if ! perl -MEncode -0777 -e \
      '"'"'$_ = Encode::decode("UTF-8", <>);
       exit !(/25\x{A0}MHz/ && /Figure\x{A0}1/ &&
               /Fran\x{00E7}ais\x{202F}:/)'"'"' \
      "${epub_language}"
    then
      echo "error: EPUB did not preserve the documented nonbreaking spaces" >&2
      exit 1
    fi

    rm \
      "${html_text}" \
      "${epub_text}" \
      "${epub_language}" \
      "${epub_svg}" \
      "${epub_listing}" \
      "${epub_css}"
    echo "ok: HTML/EPUB structure, appendix grouping/omission, code/math/figure/component/icon/notice/glossary contracts, locale semantics, theme, embedded fonts, and heading markers"
  '
