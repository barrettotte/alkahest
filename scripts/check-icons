#!/usr/bin/env perl
# Validate the semantic icon registry, assets, aliases, and manuscript calls.
use strict;
use warnings;
use File::Find qw(find);
use FindBin qw($Bin);
use Cwd qw(abs_path);

my $repo_root = abs_path("$Bin/..");
my $book_root = "$repo_root/book";
my $registry_path = "$book_root/_extensions/alkahest-icons/registry.lua";
my (%entries, %lookup);
my $current;

open my $registry, '<', $registry_path
  or die "error: cannot read icon registry $registry_path: $!\n";
while (my $line = <$registry>) {
  if ($line =~ /^  ([a-z][a-z0-9-]*) = \{\s*$/
      || $line =~ /^  \["([a-z][a-z0-9-]*)"\] = \{\s*$/) {
    $current = $1;
    die "error: duplicate canonical icon name: $current\n"
      if exists $entries{$current};
    $entries{$current} = { aliases => [] };
  } elsif (defined $current && $line =~ /^    asset = "([^"]+)",/) {
    $entries{$current}{asset} = $1;
  } elsif (defined $current && $line =~ /^    label = "([^"]+)",/) {
    $entries{$current}{label} = $1;
  } elsif (defined $current && $line =~ /^    aliases = \{(.*)\},/) {
    my @aliases = $1 =~ /"([a-z][a-z0-9-]*)"/g;
    $entries{$current}{aliases} = \@aliases;
  } elsif (defined $current && $line =~ /^  \},/) {
    $current = undef;
  }
}
close $registry;

for my $required (qw(equipment warning danger idea experiment optional-material)) {
  die "error: icon registry is missing required name: $required\n"
    unless exists $entries{$required};
}

for my $name (sort keys %entries) {
  my $entry = $entries{$name};
  die "error: icon $name has no default label\n"
    unless defined $entry->{label} && length $entry->{label};
  die "error: icon $name has no asset\n"
    unless defined $entry->{asset};
  die "error: icon $name has an unsafe asset path: $entry->{asset}\n"
    unless $entry->{asset} =~ m{^icons/[a-z0-9-]+\.svg$};

  my $asset_path = "$book_root/$entry->{asset}";
  open my $asset, '<', $asset_path
    or die "error: icon $name is missing asset $entry->{asset}: $!\n";
  local $/;
  my $svg = <$asset>;
  close $asset;
  die "error: icon $name asset must use the shared 24 by 24 SVG view box\n"
    unless $svg =~ /viewBox="0 0 24 24"/;
  die "error: icon $name asset must not contain embedded text\n"
    if $svg =~ /<text\b/i;

  for my $key ($name, @{ $entry->{aliases} }) {
    die "error: duplicate icon name or alias: $key\n" if exists $lookup{$key};
    $lookup{$key} = $name;
  }
}

my @sources;
find(
  {
    wanted => sub {
      return unless -f $_ && /\.qmd\z/;
      return if $File::Find::name =~ m{/(?:\.quarto|_build)/};
      push @sources, $File::Find::name;
    },
    no_chdir => 1,
  },
  $book_root,
);

my $calls = 0;
for my $source (sort @sources) {
  open my $input, '<', $source or die "error: cannot read $source: $!\n";
  my ($line_number, $disabled_fence, $pending_notice) = (0, undef, undef);
  while (my $line = <$input>) {
    ++$line_number;
    if (defined $disabled_fence) {
      $disabled_fence = undef if $line =~ /^\Q$disabled_fence\E\s*$/;
      next;
    }
    if ($line =~ /^(`{3,}|~{3,}).*\bshortcodes=false\b/) {
      $disabled_fence = $1;
      next;
    }
    if ($line =~ /^:{3,}.*\.icon-notice\b/) {
      die "error: $source:$line_number: .icon-notice must set icon=false\n"
        unless $line =~ /\bicon=false\b/;
      $pending_notice = $line_number;
      next;
    }
    if (defined $pending_notice && $line !~ /^\s*$/) {
      die "error: $source:$pending_notice: .icon-notice must be followed by a title containing alk-icon\n"
        unless $line =~ /^#{1,6}\s+.*\{\{<\s*alk-icon\s+/;
      $pending_notice = undef;
    }
    if ($line =~ /\{\{<\s*alk-icon\s*>\}\}/) {
      die "error: $source:$line_number: alk-icon is missing a registry name\n";
    }
    while ($line =~ /\{\{<\s*alk-icon\s+(.+?)\s*>\}\}/g) {
      my $arguments = $1;
      my $visible_after = substr($line, pos($line));
      my ($name, $remainder) = $arguments =~ /^([a-z][a-z0-9-]*)(.*)$/;
      die "error: $source:$line_number: invalid alk-icon registry name\n"
        unless defined $name;
      die "error: $source:$line_number: unknown alk-icon name or alias: $name\n"
        unless exists $lookup{$name};
      if ($remainder =~ /\blabel\s*=\s*""/) {
        die "error: $source:$line_number: alk-icon label must not be empty\n";
      }
      $remainder =~ s/\blabel\s*=\s*(?:"[^"]+"|'[^']+'|[^\s]+)//g;
      $remainder =~ s/\s+//g;
      die "error: $source:$line_number: unexpected alk-icon arguments: $remainder\n"
        if length $remainder;
      $visible_after =~ s/\{\{<.*?>\}\}//g;
      $visible_after =~ s/<!--.*?-->//g;
      $visible_after =~ s/\{[^{}]*\}//g;
      $visible_after =~ s/<[^>]*>//g;
      $visible_after =~ s/&(?:[A-Za-z][A-Za-z0-9]+|#[0-9]+|#x[0-9A-Fa-f]+);//g;
      die "error: $source:$line_number: alk-icon must be followed on the same line by visible text\n"
        unless $visible_after =~ /[\p{L}\p{N}]/;
      ++$calls;
    }
  }
  close $input;
  die "error: $source:$pending_notice: .icon-notice has no title\n"
    if defined $pending_notice;
}

die "error: no semantic icon shortcode calls were found\n" unless $calls;
print "ok: semantic icon registry (" . scalar(keys %entries)
  . " canonical names; " . scalar(keys %lookup)
  . " names and aliases; $calls manuscript calls)\n";
