#!/usr/bin/env perl
# Validate grouped appendix manifests and exceptional availability metadata.
use strict;
use warnings;
use Cwd qw(abs_path);
use File::Find qw(find);
use FindBin qw($Bin);

my $repo_root = abs_path("$Bin/..");
my $book_root = "$repo_root/book";
my @manifests = (
  { path => "$book_root/_quarto.yml", label => "default" },
);
my %all_sources;
my $group_count = 0;

sub fail {
  die "error: $_[0]\n";
}

sub parse_manifest {
  my ($manifest) = @_;
  open my $handle, '<:encoding(UTF-8)', $manifest->{path}
    or fail("cannot read $manifest->{path}");
  my $in_appendices = 0;
  my $in_chapters = 0;
  my $current_group;
  my %groups;
  my @sources;
  while (my $line = <$handle>) {
    if ($line =~ /^  appendices:\s*$/) {
      $in_appendices = 1;
      $in_chapters = 0;
      next;
    }
    next if !$in_appendices;
    last if $line =~ /^\S/ || $line =~ /^  [a-zA-Z0-9_-]+:/;
    next if $line =~ /^\s*(?:#.*)?$/;
    if ($line =~ /^    - part: "([^"]+)"\s*$/) {
      $current_group = $1;
      fail("duplicate appendix group '$current_group' in $manifest->{label} manifest")
        if $groups{$current_group}++;
      $group_count++;
      $in_chapters = 0;
      next;
    }
    if ($line =~ /^      chapters:\s*$/ && defined $current_group) {
      $in_chapters = 1;
      next;
    }
    if ($line =~ /^        - ([a-zA-Z0-9_\/-]+\.qmd)\s*$/ && $in_chapters) {
      my $source = $1;
      fail("appendix source '$source' is listed twice in $manifest->{label} manifest")
        if grep { $_ eq $source } @sources;
      push @sources, $source;
      $all_sources{$source} = 1;
      next;
    }
    fail("unsupported appendix structure in $manifest->{label} manifest: $line");
  }
  close $handle;
  fail("$manifest->{label} manifest has no grouped appendices") if !@sources;
}

parse_manifest($_) for @manifests;

my @disk_sources;
find(
  sub {
    return if !-f $_ || $_ !~ /\.qmd$/;
    my $path = $File::Find::name;
    $path =~ s/^\Q$book_root\E\///;
    push @disk_sources, $path;
  },
  "$book_root/appendices",
);

for my $source (sort @disk_sources) {
  my $path = "$book_root/$source";
  open my $handle, '<:encoding(UTF-8)', $path or fail("cannot read $path");
  local $/;
  my $content = <$handle>;
  close $handle;
  my @headings = ($content =~ /^# (?!#)(.+?)\s+\{#([^}]+)\}\s*$/mg);
  fail("appendix source '$source' must have exactly one H1 with a stable ID")
    if @headings != 2;

  my ($availability) = $content =~ /\A---\s*\n.*?^alkahest-appendix:\s*\n\s+availability:\s*([a-z-]+)\s*$.*?^---\s*$/ms;
  if (defined $availability) {
    fail("appendix source '$source' has unsupported availability '$availability'")
      if $availability ne 'online-only' && $availability ne 'supplemental';
    fail("exceptional appendix '$source' appears in the default book")
      if $all_sources{$source};
  } elsif (!$all_sources{$source}) {
    fail("appendix source '$source' is neither selected nor marked with exceptional availability");
  }
}
for my $source (sort keys %all_sources) {
  fail("appendix manifest references missing source '$source'")
    if !-f "$book_root/$source";
}

print "ok: appendix structure ($group_count groups; " . scalar(@disk_sources)
  . " canonical sources; exceptional material deferred to edition manifests)\n";
