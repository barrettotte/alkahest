#!/usr/bin/env perl
# Validate subject/person index identity, hierarchy, markers, ranges, and redirects.
use strict;
use warnings;
use Cwd qw(abs_path);
use File::Find qw(find);
use FindBin qw($Bin);

my $repo_root = abs_path("$Bin/..");
my $book_root = $ENV{ALKAHEST_INDEX_BOOK_ROOT} // "$repo_root/book";
$book_root = abs_path($book_root)
  or die "error: index book root does not exist\n";
my $registry_path = "$book_root/index.yml";

open my $registry, '<:encoding(UTF-8)', $registry_path
  or die "error: cannot read index registry $registry_path: $!\n";
my @registry_lines = <$registry>;
close $registry;

my ($version, $language, $in_entries, $current, $list_field);
my %entries;
for (my $index = 0; $index < @registry_lines; ++$index) {
  my $line_number = $index + 1;
  my $line = $registry_lines[$index];
  chomp $line;
  next if $line =~ /^\s*(?:#.*)?$/;
  if ($line =~ /^version: ([0-9]+)$/) {
    die "error: $registry_path:$line_number: duplicate version\n"
      if defined $version;
    $version = $1;
    next;
  }
  if ($line =~ /^lang: (\S+)$/) {
    die "error: $registry_path:$line_number: duplicate language\n"
      if defined $language;
    $language = $1;
    next;
  }
  if ($line eq 'entries:') {
    $in_entries = 1;
    $current = undef;
    $list_field = undef;
    next;
  }
  if ($in_entries && $line =~ /^  ([a-z][a-z0-9-]*):$/) {
    $current = $1;
    die "error: $registry_path:$line_number: duplicate index ID: $current\n"
      if exists $entries{$current};
    $entries{$current} = { line => $line_number };
    $list_field = undef;
    next;
  }
  die "error: $registry_path:$line_number: field appears before an index ID\n"
    unless $in_entries && defined $current;
  if ($line =~ /^    (term|kind|sort|parent|see): (\S.*)$/) {
    my ($field, $value) = ($1, $2);
    die "error: $registry_path:$line_number: duplicate $field for $current\n"
      if exists $entries{$current}{$field};
    $entries{$current}{$field} = $value;
    $list_field = undef;
    next;
  }
  if ($line =~ /^    (aliases|locations|ranges|see-also):$/) {
    $list_field = $1;
    die "error: $registry_path:$line_number: duplicate $list_field for $current\n"
      if exists $entries{$current}{$list_field};
    $entries{$current}{$list_field} = [];
    next;
  }
  if (defined $list_field && $line =~ /^      - (\S.*)$/) {
    push @{ $entries{$current}{$list_field} }, $1;
    next;
  }
  die "error: $registry_path:$line_number: unsupported index syntax: $line\n";
}

die "error: index registry version must be 1\n"
  unless defined $version && $version == 1;
die "error: index registry language must be a BCP 47 tag\n"
  unless ($language // '') =~ /^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$/;
die "error: index registry has no entries\n" unless keys %entries;

my (%lookup, %display_paths, %child_count);
for my $name (sort keys %entries) {
  $lookup{$name} = $name;
}
for my $name (sort keys %entries) {
  my $entry = $entries{$name};
  die "error: index entry $name has no term\n"
    unless defined $entry->{term} && $entry->{term} =~ /\S/;
  die "error: index entry $name has unsupported kind\n"
    unless ($entry->{kind} // '') eq 'subject'
      || ($entry->{kind} // '') eq 'person';
  die "error: index entry $name has invalid sort value\n"
    if defined $entry->{sort} && $entry->{sort} !~ /^[A-Za-z0-9][A-Za-z0-9 .,'-]*$/;
  for my $field (qw(aliases locations ranges see-also)) {
    my %seen;
    for my $value (@{ $entry->{$field} // [] }) {
      die "error: index entry $name has duplicate $field value $value\n"
        if $seen{$value}++;
    }
  }
  for my $alias (@{ $entry->{aliases} // [] }) {
    die "error: index entry $name has invalid alias $alias\n"
      unless $alias =~ /^[a-z][a-z0-9-]*$/;
    die "error: duplicate index name or alias: $alias\n"
      if exists $lookup{$alias};
    $lookup{$alias} = $name;
  }
}

for my $name (sort keys %entries) {
  my $entry = $entries{$name};
  if (defined $entry->{parent}) {
    die "error: index entry $name has invalid parent\n"
      unless $entry->{parent} =~ /^[a-z][a-z0-9-]*$/
        && exists $entries{$entry->{parent}}
        && $entry->{parent} ne $name;
    die "error: index entry $name and its parent have different kinds\n"
      unless $entry->{kind} eq $entries{$entry->{parent}}{kind};
    ++$child_count{$entry->{parent}};
  }
  if (defined $entry->{see}) {
    die "error: index entry $name has invalid see target\n"
      unless $entry->{see} =~ /^[a-z][a-z0-9-]*$/
        && exists $entries{$entry->{see}}
        && $entry->{see} ne $name;
    die "error: redirect index entry $name cannot have locators, ranges, or see-also\n"
      if @{ $entry->{locations} // [] }
        || @{ $entry->{ranges} // [] }
        || @{ $entry->{'see-also'} // [] };
  }
  for my $target (@{ $entry->{'see-also'} // [] }) {
    die "error: index entry $name has invalid see-also target $target\n"
      unless $target =~ /^[a-z][a-z0-9-]*$/
        && exists $entries{$target}
        && $target ne $name;
  }
}

# Parent and redirect chains must terminate; cycles make hierarchy and
# cross-reference output unstable even when every individual target exists.
for my $field (qw(parent see)) {
  for my $name (sort keys %entries) {
    my %visited;
    my $cursor = $name;
    while (defined $entries{$cursor}{$field}) {
      die "error: index $field cycle includes $cursor\n" if $visited{$cursor}++;
      $cursor = $entries{$cursor}{$field};
    }
  }
}

my (%expected_points, %expected_ranges);
for my $name (sort keys %entries) {
  my $entry = $entries{$name};
  for my $field (qw(locations ranges)) {
    for my $locator (@{ $entry->{$field} // [] }) {
      die "error: index entry $name has malformed $field locator $locator\n"
        unless $locator =~ m{^((?:appendices/)?[a-z0-9][a-z0-9-]*\.qmd)#([a-z][a-z0-9-]*)$};
      my ($source, $marker) = ($1, $2);
      die "error: index locator source does not exist: $source\n"
        unless -f "$book_root/$source";
      my $key = join("\0", $name, $source, $marker);
      my $target = $field eq 'locations' ? \%expected_points : \%expected_ranges;
      die "error: duplicate declared index locator $name $source#$marker\n"
        if exists $target->{$key};
      $target->{$key} = 1;
    }
  }
  if (!defined $entry->{see}
      && !@{ $entry->{locations} // [] }
      && !@{ $entry->{ranges} // [] }
      && !$child_count{$name}) {
    die "error: index entry $name has no locator, range, child, or redirect\n";
  }
}

my @sources;
find(
  {
    wanted => sub {
      return unless -f $_ && /\.qmd\z/;
      return if $File::Find::name =~ m{/(?:\.quarto|_build)/};
      push @sources, $File::Find::name;
    },
    no_chdir => 1,
  },
  $book_root,
);

my (%observed_points, %observed_range_edges, %aliases_used);
my $placeholders = 0;
for my $source (sort @sources) {
  open my $input, '<:encoding(UTF-8)', $source
    or die "error: cannot read $source: $!\n";
  my @lines = <$input>;
  close $input;
  my $relative = $source;
  $relative =~ s/^\Q$book_root\E\///;
  my $in_fence;
  for (my $index = 0; $index < @lines; ++$index) {
    my $line = $lines[$index];
    if (defined $in_fence) {
      $in_fence = undef if $line =~ /^\Q$in_fence\E\s*$/;
      next;
    }
    if ($line =~ /^(`{3,}|~{3,})/) {
      $in_fence = $1;
      next;
    }
    ++$placeholders
      while $line =~ /\{\.alkahest-index-placeholder\}/g;
    die "error: $relative:" . ($index + 1)
      . ": use alk-index rather than a backend-specific index command\n"
      if $line =~ /\\index\s*\{/;
    while ($line =~ /\{\{<\s*alk-index\b(.*?)>\}\}/g) {
      my $arguments = $1;
      die "error: $relative:" . ($index + 1)
        . ": malformed alk-index shortcode\n"
        unless $arguments =~ /^\s+([a-z][a-z0-9-]*)\s+id=([a-z][a-z0-9-]*)(?:\s+range=(start|end))?\s*$/;
      my ($requested, $marker, $edge) = ($1, $2, $3);
      my $canonical = $lookup{$requested}
        or die "error: $relative:" . ($index + 1)
          . ": unknown index name or alias $requested\n";
      ++$aliases_used{$requested} if $requested ne $canonical;
      my $key = join("\0", $canonical, $relative, $marker);
      if (defined $edge) {
        die "error: duplicate index range $edge marker for $canonical $relative#$marker\n"
          if $observed_range_edges{$key}{$edge}++;
      } else {
        die "error: duplicate index point marker for $canonical $relative#$marker\n"
          if $observed_points{$key}++;
      }
    }
    if ($line =~ /\{\{<\s*alk-index\b/ && $line !~ /\{\{<\s*alk-index\b.*?>\}\}/) {
      die "error: $relative:" . ($index + 1) . ": unterminated alk-index shortcode\n";
    }
  }
}

die "error: expected exactly one index placeholder; found $placeholders\n"
  unless $placeholders == 1;
for my $key (sort keys %expected_points) {
  die "error: declared index point has no matching marker: "
    . join(' ', split("\0", $key)) . "\n"
    unless $observed_points{$key};
}
for my $key (sort keys %observed_points) {
  die "error: undeclared index point marker: "
    . join(' ', split("\0", $key)) . "\n"
    unless $expected_points{$key};
}
for my $key (sort keys %expected_ranges) {
  my $edges = $observed_range_edges{$key} // {};
  die "error: declared index range needs exactly one start and one end: "
    . join(' ', split("\0", $key)) . "\n"
    unless ($edges->{start} // 0) == 1 && ($edges->{end} // 0) == 1;
}
for my $key (sort keys %observed_range_edges) {
  die "error: undeclared index range marker: "
    . join(' ', split("\0", $key)) . "\n"
    unless $expected_ranges{$key};
}

my $point_count = scalar keys %expected_points;
my $range_count = scalar keys %expected_ranges;
my $alias_count = scalar keys %aliases_used;
print "ok: subject/person indexes (" . scalar(keys %entries)
  . " entries; $point_count point markers; $range_count range; "
  . "$alias_count aliases exercised; nested entries; see/see-also; one generated index)\n";
